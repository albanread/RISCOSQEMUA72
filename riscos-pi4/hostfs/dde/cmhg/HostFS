; HostFS cmhg control file (DDE build).
;
; cmhg generates the RISC OS module header, the init/final/*command
; veneers, and the seven generic FS entry veneers.  The FS information
; block handed to OS_FSControl 12 is built at runtime in c.hostfs, the
; way LanManFS does it, so no link-time offset arithmetic is involved.

title-string:            HostFS
help-string:             HostFS 1.01 (10 Sep 2026)
initialisation-code:     hostfs_init
finalisation-code:       hostfs_final

generic-veneers:         fsentry_open,
                         fsentry_get,
                         fsentry_put,
                         fsentry_args,
                         fsentry_close,
                         fsentry_file,
                         fsentry_func

command-keyword-table:   hostfs_commands
; cmd_no 0 — the C switch in c.hostfs indexes this table by position
  HostFSPing(min-args:0, max-args:0, add-syntax:,
         help-text:"*HostFSPing rings the vmchannel doorbell and expects an echo\r",
         invalid-syntax:"Syntax:\t*HostFSPing"),
; cmd_no 1
  HostFSStatus(min-args:0, max-args:0, add-syntax:,
         help-text:"*HostFSStatus prints the doorbell state and FileSwitch registration probes\r",
         invalid-syntax:"Syntax:\t*HostFSStatus")
