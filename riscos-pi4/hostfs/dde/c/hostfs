/* hostfs.c — the HostFS module body (riscos-pi4/FSDESIGN-V1.md).
 *
 * A filing system over the vmchannel doorbell.  Each FileSwitch call puts
 * its registers into one request block, rings the doorbell, and takes the
 * registers back: the host does the work, including reaching the caller's
 * buffers by walking the guest's page tables.
 *
 * Built to run from ROM.  A module on the ROM chain executes in place, out
 * of read-only memory, so this module
 *
 *   - keeps every variable in one workspace claimed from the RMA at
 *     initialisation, whose address lives in the module's private word
 *     (struct hostws, below);
 *   - holds no absolute address, so nothing in the image needs relocating
 *     wherever it lands.  Link appends self-relocation code only to a
 *     module that imports __RelocCode, and s.head does not; the constant
 *     data that C would reach through an address — the error blocks, the
 *     FS information block — is in s.head, reached with ADR;
 *   - links no C library.  C:o.stubs initialises by patching the stub
 *     vectors inside the image, and its module entry claims the private
 *     word for the C runtime.  So there is no printf and no division here,
 *     and swix() in s.head stands in for _kernel_swi.
 *
 * Build,feb assembles s.head with objasm, compiles this with cc, and links
 * the two with link -rmf.  `decaof -r o.hostfs` must list no relocation
 * but PC-relative ones.  The same image soft-loads with RMLoad.
 */

#define NULL ((void *)0)

/* The two DDE kernel.h types the code is written against, as that header
 * defines them, so the handlers still read in PRM register terms. */
typedef struct { int r[10]; } _kernel_swi_regs;
typedef struct { int errnum; char errmess[252]; } _kernel_oserror;

typedef unsigned int   uint32_t;
typedef int            int32_t;
typedef unsigned char  uint8_t;

/* ---- the doorbell ------------------------------------------------- */

/* RISC OS maps peripherals into logical space on demand, not at a
 * fixed window: OS_Memory 13 (MapIOPermanent) hands back the logical
 * base for the doorbell's physical page at 0xFE005000 (mirrored by
 * QEMU beside the system timer in the high peripheral window).  The
 * logical address is only known at runtime. */
#define VMCH_PHYS        0xFE005000u
#define VMCH_SIZE        0x1000u
#define VMCH_MAGIC      0x00
#define VMCH_FEATURES   0x08
#define VMCH_CMD        0x0C
#define VMCH_MAGIC_VALUE 0x48434D56u
#define VMCH_FEATURE_FS 0x1u
#define VMCH_FEATURE_FSENTRY  0x8u      /* v1 register-frame commands */
#define VMCH_FEATURE_VIRTADDR 0x10u     /* host walks the guest's MMU */

#define VMCH_MAX_ARG 4032   /* 64-byte header + 4032 = one 4 KB page */
#define VMCH_MAX_OPEN 16                 /* device handle slots (1-based) */

/* The request block, mirroring include/hw/misc/vmchannel.h exactly.
 * The device reads BYTE offsets; the previous H_* word indices
 * mismatched every field past CMD, so rc/arglen/handle were read from
 * bytes the device never writes.  One struct, byte-accurate, so the
 * two sides cannot drift again. */
struct vmreq {
    uint32_t cmd;                       /* +0  VMCH_HDR_CMD */
    uint32_t seq;                       /* +4  VMCH_HDR_SEQ */
    uint32_t rc;                        /* +8  VMCH_HDR_RC */
    uint32_t handle;                    /* +12 VMCH_HDR_HANDLE */
    uint32_t arglen;                    /* +16 VMCH_HDR_ARGLEN */
    uint8_t  scratch[44];               /* +20 VMCH_HDR_ARG .. +63 */
    uint8_t  data[VMCH_MAX_ARG];        /* +64 VMCH_HDR_SIZE */
};

/* word n of the scratch arg area (READ/WRITE buffer+count, SEEK
 * offset+whence, SETSIZE size) */
#define REQW(n) (*(uint32_t *)&req->scratch[(n) * 4])

/* v1: the register frame goes on the wire and the host does the work.
 * scratch[] starts at +20, which is where R0..R7 live, so REQW(n) is Rn. */
#define C_FS_GETBYTES 0x101
#define C_FS_PUTBYTES 0x102
#define C_FS_ARGS     0x103
#define C_FS_FILE     0x105
#define C_FS_FUNC     0x106
#define C_RENAME      10

#define C_PING     0
#define C_OPEN     1
#define C_CLOSE    2
#define C_READ     3
#define C_WRITE    4
#define C_SEEK     5
#define C_FILEARGS 6
#define C_CAT      7
#define C_CREATE   8
#define C_DELETE   9
#define C_SETSIZE 18

#define RC_OK        0
#define RC_NOROOT    1
#define RC_NOTFOUND  2
#define RC_ACCESS    3
#define RC_BADPATH   4
#define RC_FULL      5
#define RC_HANDLES   6
#define RC_NOTDIR    7
#define RC_ISDIR     8
#define RC_BADCMD    9
#define RC_IOERR    10
#define RC_BADADDR  11   /* a guest address would not translate */

#define O_READ   0x1u
#define O_WRITE  0x2u
#define O_CREATE 0x4u
#define O_TRUNC  0x8u

/* XSWI numbers (swis.h pulls in a large generated header; these four
 * are all this module needs) */
#define XOS_Write0          0x20002
#define XOS_NewLine         0x20003
#define XOS_Module          0x2001E
#define XOS_FSControl       0x20029
#define XOS_Memory          0x20068

/* in s.head: any SWI, as its X form, through OS_CallASWIR12 */
_kernel_oserror *swix(int swi, const _kernel_swi_regs *in,
                      _kernel_swi_regs *out);

/* in s.head: OS_FSControl 12 with the information block there */
_kernel_oserror *hostfs_register(void *pw);

/* in s.head: Free_Register (or with deregister, Free_DeRegister) so that
 * *ShowFree and the filer's Free window can read HostFS's free space */
struct hostws;
_kernel_oserror *hostfs_free_register(struct hostws *ws, int deregister);

/* in s.head: the constant error blocks, by number, in its table's order */
_kernel_oserror *hostfs_error(int which);
