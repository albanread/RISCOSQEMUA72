/* one catalogue entry as cached from CAT */
struct catent {
    uint32_t load, exec, len, attr, type;
    char name[40];
};

/*
 * Everything this module writes.
 *
 * A module on the ROM chain executes in place and may not write its own
 * image, so no variable can be a C static: from ROM a store into one is a
 * data abort at the image offset of the variable.  It all lives here
 * instead, in one block claimed from the RMA in hostfs_init, whose address
 * is kept in the module's private word — the word R12 points at on every
 * entry, which the veneers in s.head hand each handler as `pw`, and which
 * FSControl_AddFS hands FileSwitch so that the FS entry veneers get it too.
 *
 * There is deliberately no file-scope pointer to this block.  That pointer
 * would itself be a writable static, and assigning it in init is exactly
 * the store that aborts from ROM.  Every function that needs the workspace
 * is given it: handlers take it from pw with WS_OF(), helpers receive it as
 * their first argument.
 *
 * The macros keep the old names readable (`req->cmd`) and require a `ws` in
 * scope, so a function that was not given the workspace fails to compile
 * rather than quietly touching something else.  `seq` has no macro: struct
 * vmreq has a member of that name, and the macro would rewrite `req->seq`
 * too.
 *
 * Constant data stays in the image, which ROM leaves readable: string
 * literals, which cc addresses PC-relative, and in s.head the error
 * blocks and the FS information block.
 */
struct hostws {
    uint32_t w_freesave[8];             /* FreeEntry's registers, in s.head:
                                         * it must be first */
    volatile uint32_t *w_vmch;          /* doorbell, from OS_Memory 13 */
    struct vmreq *w_req;                /* page-aligned inside w_reqstore */
    uint32_t w_req_phys;                /* its physical address */
    uint32_t w_seq;
    int w_registered;
    uint32_t w_hptr[VMCH_MAX_OPEN];     /* per handle; handles are 1-based */
    uint32_t w_hext[VMCH_MAX_OPEN];
    uint32_t w_hload[VMCH_MAX_OPEN];
    uint32_t w_hexec[VMCH_MAX_OPEN];
    _kernel_oserror w_err_func;         /* the errors formatted at run time */
    _kernel_oserror w_err_badaddr;
    struct catent w_catents[128];
    /* The request block must be one whole page, and Norcroft has no
     * aligned attribute: over-allocate and line the block up in init. */
    uint8_t w_reqstore[sizeof(struct vmreq) + 4096];
};

#define WS_OF(pw)        (*(struct hostws **)(pw))

#define vmch             (ws->w_vmch)
#define req              (ws->w_req)
#define req_phys         (ws->w_req_phys)
#define registered       (ws->w_registered)
#define hptr             (ws->w_hptr)
#define hext             (ws->w_hext)
#define hload            (ws->w_hload)
#define hexec            (ws->w_hexec)
#define err_func_buf     (ws->w_err_func)
#define err_badaddr_buf  (ws->w_err_badaddr)
#define catents          (ws->w_catents)
#define reqstore         (ws->w_reqstore)

#define vmch_reg(idx) (vmch[idx])

/* Per-handle state, for FSEntry_Args: the doorbell is stateless (each
 * op carries its own seek), so ptr/ext/load/exec live here instead.
 * Device handles are 1-based; 0 means no file. */
/* FileSwitch buffer size: power of two, 64..1024 (PRM 2-541).  Take the
 * maximum — the doorbell, not the copy, is what a transfer costs. */
#define HOSTFS_BUFSIZE 1024u


/* Built per-call so the offset of the first unreachable byte is in the
 * message.  A short transfer is nearly always a partial-coverage bug in
 * whatever prepared the buffer, and the offset points straight at it —
 * "+258300" says the last page was missed, which a bare "not mapped"
 * would have left to a diagnostic build to discover. */

/* "unsupported operation" with no number turned one missing reason code
 * into an afternoon of reading FileSwitch; say which. */
/* string building, in place of sprintf: each returns the new end */
static char *str_copy(char *d, const char *src)
{
    while ((*d = *src++) != 0) {
        d++;
    }
    return d;
}

/* One decimal digit of n at place value p, by subtraction: cc compiles
 * division to a call into the C library, which this module does not link. */
static char *dec_digit(char *d, uint32_t *n, uint32_t p, int *started)
{
    char c = '0';

    while (*n >= p) {
        *n -= p;
        c++;
    }
    if (c != '0' || *started || p == 1u) {
        *d++ = c;
        *started = 1;
    }
    return d;
}

static char *str_dec(char *d, uint32_t n)
{
    int started = 0;

    d = dec_digit(d, &n, 1000000000u, &started);
    d = dec_digit(d, &n, 100000000u, &started);
    d = dec_digit(d, &n, 10000000u, &started);
    d = dec_digit(d, &n, 1000000u, &started);
    d = dec_digit(d, &n, 100000u, &started);
    d = dec_digit(d, &n, 10000u, &started);
    d = dec_digit(d, &n, 1000u, &started);
    d = dec_digit(d, &n, 100u, &started);
    d = dec_digit(d, &n, 10u, &started);
    d = dec_digit(d, &n, 1u, &started);
    *d = 0;
    return d;
}

static _kernel_oserror *unsupported_func(struct hostws *ws, uint32_t reason)
{
    char *p;

    err_func_buf.errnum = 0x1E8;
    p = str_copy(err_func_buf.errmess, "HostFS: FSEntry_Func ");
    p = str_dec(p, reason);
    (void)str_copy(p, " is not supported");
    return &err_func_buf;
}


static _kernel_oserror *badaddr_at(struct hostws *ws, uint32_t off)
{
    char *p;

    err_badaddr_buf.errnum = 0x1E9;
    p = str_copy(err_badaddr_buf.errmess,
                 "HostFS: transfer buffer not mapped at +");
    (void)str_dec(p, off);
    return &err_badaddr_buf;
}

static _kernel_oserror *rc_to_error(uint32_t rc)
{
    switch (rc) {
    case RC_OK: return NULL;
    case RC_NOTFOUND: return &err_notfound;
    case RC_ACCESS: case RC_HANDLES: return &err_access;
    case RC_BADPATH: return &err_badpath;
    case RC_FULL: return &err_full;
    case RC_NOROOT: return &err_nofs;
    default: return &err_unsupported;
    }
}

/* ---- the transport -------------------------------------------------- */

static uint32_t vmch_go(struct hostws *ws)
{
    req->seq = ++ws->w_seq;
    req->rc = 0xFFFFFFFFu;             /* poison: an unanswered request stays visible */
    vmch_reg(VMCH_CMD / 4) = req_phys; /* the device DMAs physical, not logical */
    return req->rc;
}

static uint32_t vmch_arglen(struct hostws *ws)
{
    return req->arglen;
}

/* path: NUL-terminated RISC OS path into the arg area */
static void put_two_paths(struct hostws *ws, const char *a, const char *b)
{
    char *arg = (char *)req->data;
    uint32_t i = 0, j;

    for (j = 0; (unsigned char)a[j] >= 32 && i < VMCH_MAX_ARG - 2; j++) {
        arg[i++] = a[j];
    }
    arg[i++] = '\n';                  /* the device splits on this */
    for (j = 0; (unsigned char)b[j] >= 32 && i < VMCH_MAX_ARG - 1; j++) {
        arg[i++] = b[j];
    }
    arg[i] = 0;
    req->arglen = i;
}

static void put_path(struct hostws *ws, const char *path)
{
    char *arg = (char *)req->data;
    uint32_t i = 0;

    while (path[i] && i < VMCH_MAX_ARG - 1) {
        arg[i] = path[i];
        i++;
    }
    arg[i] = 0;
    req->arglen = i;
}


/* FILEARGS response: size, type, attr, cs_lo, cs_hi, load, exec.
 * load and exec are computed host-side; nothing in this module
 * knows how a load address is put together any more. */
static uint32_t info_of(struct hostws *ws, const char *path,
                        uint32_t *size, uint32_t *type,
                        uint32_t *attr, uint32_t *cs_lo, uint32_t *cs_hi,
                        uint32_t *load, uint32_t *exec)
{
    uint32_t rc;
    uint32_t *resp;

    req->cmd = C_FILEARGS;
    req->handle = 0;
    put_path(ws, path);
    rc = vmch_go(ws);
    if (rc != RC_OK) {
        return rc;
    }
    resp = (uint32_t *)req->data;
    *size = resp[0];
    *type = resp[1];
    *attr = resp[2];
    *cs_lo = resp[3];
    *cs_hi = resp[4];
    *load = resp[5];                 /* computed host-side: the module */
    *exec = resp[6];                 /* never has to know the format */
    return RC_OK;
}

/* object type in the OS_File sense: 1 file, 2 directory, 0 none */
static uint32_t objtype_of(uint32_t rc, uint32_t type)
{
    if (rc != RC_OK) {
        return 0;
    }
    return type == 0 ? 2 : 1;
}

/* FSEntry_File on the host: R0 reason, R2 load, R3 exec, R5 attr, and the
 * path inline.  The host decides what they mean — including that setting
 * a type renames the file — so this passes them through and nothing
 * more. */
static uint32_t file_on_host(struct hostws *ws, _kernel_swi_regs *r,
                             const char *name)
{
    req->cmd = C_FS_FILE;
    req->handle = 0;
    REQW(0) = (uint32_t)r->r[0];
    REQW(2) = (uint32_t)r->r[2];
    REQW(3) = (uint32_t)r->r[3];
    REQW(5) = (uint32_t)r->r[5];
    put_path(ws, name);
    return vmch_go(ws);
}

static uint32_t vmch_req_close(struct hostws *ws, uint32_t h)
{
    req->cmd = C_CLOSE;
    req->handle = h;
    req->arglen = 0;
    return vmch_go(ws);
}

/* ---- guest buffer plumbing ------------------------------------------ */

/* OS_Memory 0: translate one logical address to physical.  The device
 * DMAs physical memory, so every guest buffer address must go through
 * this before it enters a request block. */
struct pbrec {
    int32_t  page;                  /* physical page number */
    uint32_t log;                   /* logical address */
    uint32_t phys;                  /* physical address */
};


/* Move n bytes between the file (at file offset ptr) and guest memory
 * at logical address mem.  Chunks never cross a 4KB page, so each
 * translated address stays valid for the whole chunk.  Returns bytes
 * moved; the per-handle pointer is maintained by the caller. */
/*
 * The host reads the guest's translation tables as they stand and cannot
 * fault a page in.  RISC OS maps application space lazily, so a buffer
 * the client has only just claimed is present as far as the client has
 * touched it and no further — measured: an untouched 256 KiB DIM
 * translates for 252 bytes, to the end of its first page, and no more.
 *
 * Touch it from here, one byte per page, in guest code.  That is the
 * same access any other filing system makes when it writes the caller's
 * buffer, and it goes through the guest's own abort handler, which is
 * what maps the page.  A byte is read rather than written so the buffer
 * is not disturbed if the transfer then fails.
 *
 * Safe only because this is the GBPB path.  PRM2 warns for FSEntry_Func
 * 9, 10 and 11 that "the buffer pointed to by R2 will not have been
 * validated with OS_ValidateAddress, because FileSwitch doesn't know how
 * big the buffer has to be" — and carries no such warning for
 * GetBytes/PutBytes, where the count is in R3 and FileSwitch does know.
 * So a wild pointer should not reach here, only an in-slot page the
 * client has not yet faulted in.  If one ever does, this aborts, and the
 * fix is an OS_ValidateAddress check before the loop with the BadWrt
 * error the PRM names.  Those Func entries must validate for themselves
 * when they are written.
 */
static void touch_pages(uint32_t mem, uint32_t n)
{
    volatile const uint8_t *p = (volatile const uint8_t *)mem;
    uint32_t i;
    uint8_t sink = 0;

    if (n == 0) {
        return;
    }
    for (i = 0; i < n; i += 0x1000u) {
        sink = (uint8_t)(sink | p[i]);
    }
    sink = (uint8_t)(sink | p[n - 1]);   /* the final partial page */
    (void)sink;
}

static uint32_t xfer_once(struct hostws *ws, uint32_t h, uint32_t ptr,
                          uint32_t mem, uint32_t n, int is_write)
{
    /* One round trip, whatever the size or alignment.  `mem` goes on the
     * wire as the guest's own logical address and the host walks the MMU
     * to reach it; `ptr` is the file offset, so there is no seek.
     *
     * This replaces a loop that split every transfer at 4 KiB, called
     * OS_Memory per chunk to get a physical address, and issued a SEEK
     * before each READ — two doorbells per page, and on a failed
     * translation it used the logical address as if it were physical.
     * A 256 KiB read cost 130 round trips; it now costs one. */
    req->cmd = (uint32_t)(is_write ? C_FS_PUTBYTES : C_FS_GETBYTES);
    req->arglen = 0;
    REQW(1) = h;
    REQW(2) = mem;
    REQW(3) = n;
    REQW(4) = ptr;
    {
        uint32_t rc = vmch_go(ws);

        if (rc == RC_OK) {
            return n;
        }
        /* On a partly-mapped buffer the host reports in R3 how far the
         * translation got.  Hand that back so the caller can tell a
         * short transfer from nothing at all. */
        if (rc == RC_BADADDR) {
            return REQW(3);
        }
        return 0;
    }
}

static uint32_t xfer(struct hostws *ws, uint32_t h, uint32_t ptr,
                     uint32_t mem, uint32_t n, int is_write)
{
    uint32_t moved = xfer_once(ws, h, ptr, mem, n, is_write);

    if (moved != n) {
        /* Short: the tail of the buffer is not mapped yet.  Fault it in
         * and go again.  One retry is enough — after touching, every
         * page of the buffer is present — and the common case never
         * gets here, so the fast path stays at one doorbell. */
        touch_pages(mem, n);
        moved = xfer_once(ws, h, ptr, mem, n, is_write);
    }
    return moved;
}


/* Map the doorbell on first use: OS_Memory 13 fails when called from
 * a module's init (the IO dynamic area is off-limits mid-module-load),
 * but works from any normal context, as the status probe proved.
 * vmch is published only after magic and features validate, so a map
 * onto a wrong page can never be cached. */
static _kernel_oserror *ensure_vmch(struct hostws *ws)
{
    _kernel_swi_regs r;
    _kernel_oserror *e;
    volatile uint32_t *v;

    if (vmch) {
        return NULL;
    }
    r.r[0] = 13;                     /* OS_Memory: MapIOPermanent */
    r.r[1] = (int)VMCH_PHYS;
    r.r[2] = (int)VMCH_SIZE;
    e = swix(XOS_Memory, &r, &r);
    if (e != NULL || r.r[3] == 0) {
        return &err_nomap;
    }
    v = (volatile uint32_t *)r.r[3];
    if (v[VMCH_MAGIC / 4] != VMCH_MAGIC_VALUE) {
        return &err_badmagic;
    }
    if (!(v[VMCH_FEATURES / 4] & VMCH_FEATURE_FS)) {
        return &err_nofs;
    }
    /* v1 is required, not preferred.  The v0 transfer path translated
     * addresses in the guest and fell back to the identity mapping when
     * OS_Memory failed, writing file data wherever that landed; falling
     * back to it silently would be worse than not loading. */
    if ((v[VMCH_FEATURES / 4] & (VMCH_FEATURE_FSENTRY | VMCH_FEATURE_VIRTADDR))
        != (VMCH_FEATURE_FSENTRY | VMCH_FEATURE_VIRTADDR)) {
        return &err_oldhost;
    }
    /* The device DMAs physical addresses.  The block is one page-aligned
     * page, so a single OS_Memory 0 translation covers all of it. */
    {
        struct pbrec pb;
        _kernel_swi_regs pr;
        pb.page = -1;
        pb.log = (uint32_t)req;
        pb.phys = 0;
        pr.r[0] = (1u << 9) | (1u << 13);
        pr.r[1] = (int)&pb;
        pr.r[2] = 1;
        if (swix(XOS_Memory, &pr, &pr) != NULL || pb.phys == 0) {
            return &err_nomap;
        }
        req_phys = pb.phys;
    }
    vmch = v;
    return NULL;
}

/* ---- FS entry handlers: r->r[] is the caller's register frame ------- */

_kernel_oserror *fsentry_open_handler(_kernel_swi_regs *r, void *pw)
{
    struct hostws *ws = WS_OF(pw);

    {
        _kernel_oserror *me = ensure_vmch(ws);
        if (me != NULL) {
            return me;
        }
    }

    uint32_t mode = (uint32_t)r->r[0];
    const char *name = (const char *)r->r[1];
    uint32_t flags = O_READ;
    uint32_t rc, h, idx, load, exec;
    uint32_t size = 0, type = 0xFFF, attr = 0, cs_lo = 0, cs_hi = 0;


    /* FSEntry_Open modes (PRM2 2-542): 0 read, 2 update; 1 is the
     * RISC OS 2 create+update, kept for compatibility.  FileSwitch
     * pre-creates via FSEntry_File 7 for OPENOUT. */
    if (mode == 1) {
        flags = O_WRITE | O_CREATE | O_TRUNC;
    } else if (mode == 2) {
        flags = O_WRITE | O_READ;
    }

    req->cmd = C_OPEN;
    req->handle = flags;
    put_path(ws, name);
    rc = vmch_go(ws);
    if (rc != RC_OK) {
        return rc_to_error(rc);
    }
    h = req->handle;
    if (h == 0 || h > VMCH_MAX_OPEN) {
        return &err_access;             /* 0 means "no file open" */
    }
    idx = h - 1;

    rc = info_of(ws, name, &size, &type, &attr, &cs_lo, &cs_hi, &load, &exec);
    if (rc == RC_NOTFOUND) {
        size = 0;                       /* newly created file */
        type = 0xFFF;
    } else if (rc != RC_OK) {
        vmch_req_close(ws, h);
        return rc_to_error(rc);
    }

    hptr[idx] = 0;
    hext[idx] = size;
    hload[idx] = load;
    hexec[idx] = exec;

    /* File information word, PRM 2-542.  Bit 28 (unbuffered GBPB) must
     * stay CLEAR: it tells FileSwitch the FS_gbpb entry handles multi-
     * byte transfers itself, and this module leaves that entry (info
     * block word 10) zero, so setting it dispatched every transfer into
     * nothing.  Buffered instead: R2 carries a buffer size, which
     * PRM 2-541 requires to be a power of two between 64 and 1024, and
     * FileSwitch then drives GetBytes/PutBytes in whole blocks and
     * tracks PTR#/EXT# for us. */
    r->r[0] = (int)((1u << 31) | (1u << 30) |
                    ((type == 0) ? (1u << 29) : 0u));   /* 29: directory */
    r->r[1] = (int)h;
    r->r[2] = HOSTFS_BUFSIZE;
    r->r[3] = (int)((type == 0) ? 0 : size);            /* extent */
    /* allocated space: must be a multiple of the buffer size */
    r->r[4] = (int)((size + (HOSTFS_BUFSIZE - 1u)) & ~(HOSTFS_BUFSIZE - 1u));
    return NULL;
}

_kernel_oserror *fsentry_get_handler(_kernel_swi_regs *r, void *pw)
{
    struct hostws *ws = WS_OF(pw);

    {
        _kernel_oserror *me = ensure_vmch(ws);
        if (me != NULL) {
            return me;
        }
    }

    uint32_t h = (uint32_t)r->r[1];
    uint32_t mem = (uint32_t)r->r[2];
    uint32_t n = (uint32_t)r->r[3];
    uint32_t ptr = (uint32_t)r->r[4];
    uint32_t moved;
    int idx = (int)h - 1;


    if (idx < 0 || idx >= VMCH_MAX_OPEN) {
        return &err_access;
    }
    moved = xfer(ws, h, ptr, mem, n, 0);
    hptr[idx] = ptr + moved;
    /* Buffered GetBytes has no exit registers (PRM 2-544), so the only
     * way to report a failure is to return an error — and it must be
     * reported.  Reading past the end of the file is NOT this case: the
     * host zero-fills the tail and still delivers the full count, so a
     * short `moved` means the guest buffer would not translate, and the
     * bytes the caller can see are not the file's.  Saying nothing here
     * once produced "0 bytes not transferred" over a buffer holding 252
     * good bytes and 261892 stale ones. */
    if (moved != n) {
        return badaddr_at(ws, moved);
    }
    return NULL;
}

_kernel_oserror *fsentry_put_handler(_kernel_swi_regs *r, void *pw)
{
    struct hostws *ws = WS_OF(pw);

    {
        _kernel_oserror *me = ensure_vmch(ws);
        if (me != NULL) {
            return me;
        }
    }

    uint32_t h = (uint32_t)r->r[1];
    uint32_t mem = (uint32_t)r->r[2];
    uint32_t n = (uint32_t)r->r[3];
    uint32_t ptr = (uint32_t)r->r[4];
    uint32_t moved;
    int idx = (int)h - 1;


    if (idx < 0 || idx >= VMCH_MAX_OPEN) {
        return &err_access;
    }
    moved = xfer(ws, h, ptr, mem, n, 1);
    hptr[idx] = ptr + moved;
    if (hptr[idx] > hext[idx]) {
        hext[idx] = hptr[idx];
    }
    if (moved != n) {           /* see fsentry_get_handler */
        return badaddr_at(ws, moved);
    }
    return NULL;
}

_kernel_oserror *fsentry_args_handler(_kernel_swi_regs *r, void *pw)
{
    struct hostws *ws = WS_OF(pw);

    {
        _kernel_oserror *me = ensure_vmch(ws);
        if (me != NULL) {
            return me;
        }
    }

    uint32_t h = (uint32_t)r->r[1];
    int idx = (int)h - 1;


    if (idx < 0 || idx >= VMCH_MAX_OPEN) {
        return &err_access;
    }

    /* Reason numbers are FileSwitch's internal ones (LowFSI:212), not
     * the OS_Args SWI numbers: flush arrives as 6, not 255. */
    switch (r->r[0]) {
    case 0:                            /* ReadPTR */
        r->r[2] = (int)hptr[idx];
        return NULL;
    case 1:                            /* SetPTR: host fseek extends
                                        * lazily, so just accept it */
        hptr[idx] = (uint32_t)r->r[2];
        if (hptr[idx] > hext[idx]) {
            hext[idx] = hptr[idx];
        }
        return NULL;
    case 2:                            /* ReadEXT */
        r->r[2] = (int)hext[idx];
        return NULL;
    case 3: {                          /* SetEXT: real truncate/extend */
        uint32_t ne = (uint32_t)r->r[2];

        req->cmd = C_SETSIZE;
        req->handle = h;
        req->arglen = 0;
        REQW(0) = ne;
        if (vmch_go(ws) != RC_OK) {
            return &err_access;
        }
        hext[idx] = ne;
        if (hptr[idx] > ne) {
            hptr[idx] = ne;
        }
        return NULL;
    }
    case 4:                            /* ReadSize: allocated size */
        r->r[2] = (int)((hext[idx] + 0xFFFu) & ~0xFFFu);
        return NULL;
    case 5:                            /* EOFCheck: -1 at EOF */
        r->r[2] = (hptr[idx] >= hext[idx]) ? -1 : 0;
        return NULL;
    case 6:                            /* Flush: hand back load/exec */
    case 9:                            /* ReadLoadExec */
        r->r[2] = (int)hload[idx];
        r->r[3] = (int)hexec[idx];
        return NULL;
    case 7:                            /* EnsureSize: no-op */
    case 10:                           /* ImageStampIs: image FS only */
        return NULL;
    case 8:                            /* WriteZeroes: how FileSwitch grows
                                        * a buffered file past its end.
                                        * R2 offset, R3 count, both buffer
                                        * multiples; the host writes them */
        req->cmd = C_FS_ARGS;
        req->handle = 0;
        req->arglen = 0;
        REQW(0) = 8;
        REQW(1) = h;
        REQW(2) = (uint32_t)r->r[2];
        REQW(3) = (uint32_t)r->r[3];
        {
            uint32_t rc = vmch_go(ws);
            uint32_t end = (uint32_t)r->r[2] + (uint32_t)r->r[3];

            if (rc != RC_OK) {
                return rc_to_error(rc);
            }
            if (end > hext[idx]) {
                hext[idx] = end;
            }
        }
        return NULL;
    default:                           /* 11 IOCtl */
        return &err_unsupported;
    }
}

_kernel_oserror *fsentry_close_handler(_kernel_swi_regs *r, void *pw)
{
    struct hostws *ws = WS_OF(pw);

    {
        _kernel_oserror *me = ensure_vmch(ws);
        if (me != NULL) {
            return me;
        }
    }

    uint32_t rc = vmch_req_close(ws, (uint32_t)r->r[1]);
    int idx = (int)r->r[1] - 1;

    if (idx >= 0 && idx < VMCH_MAX_OPEN) {
        hptr[idx] = hext[idx] = 0;
    }
    return (rc == RC_OK) ? NULL : rc_to_error(rc);
}

_kernel_oserror *fsentry_file_handler(_kernel_swi_regs *r, void *pw)
{
    struct hostws *ws = WS_OF(pw);

    {
        _kernel_oserror *me = ensure_vmch(ws);
        if (me != NULL) {
            return me;
        }
    }

    uint32_t reason = (uint32_t)r->r[0];
    const char *name = (const char *)r->r[1];
    uint32_t size, type, attr, cs_lo, cs_hi, rc, load, exec;


    switch (reason) {
    case 5:                            /* read catalogue info */
    case 9:                            /* ...without length */
        rc = info_of(ws, name, &size, &type, &attr, &cs_lo, &cs_hi,
                     &load, &exec);
        {
            uint32_t obj = objtype_of(rc, type);

            r->r[0] = (int)obj;
            if (!obj) {
                return NULL;
            }
            if (obj == 2) {
                load = exec = 0;
                size = 0;
                attr = 3;
            } else {
                        }
            r->r[2] = (int)load;
            r->r[3] = (int)exec;
            r->r[4] = (int)size;
            r->r[5] = (int)attr;
        }
        return NULL;

    /*
     * fsfile_Load (0xFF) and fsfile_Save (0) are retired: information
     * word bits 20 and 19 tell FileSwitch to build *Load and *Save out
     * of Open/GetBytes/PutBytes/Close instead.  Answered rather than
     * deleted, so that if FileSwitch ever calls them anyway the failure
     * is named instead of mysterious.
     */
    case 0xFF:                         /* load  */
    case 0:                            /* save  */
        return &err_retired;

    case 10:                           /* read block size (OS_File 20):
                                        * the buffer size is as natural a
                                        * block as the host offers */
        r->r[2] = HOSTFS_BUFSIZE;
        return NULL;

    case 8:                            /* create directory: the host makes
                                        * it, and leaves one that exists */
        rc = file_on_host(ws, r, name);
        return (rc == RC_OK) ? NULL : rc_to_error(rc);

    case 7:                            /* create empty, of the type in R2 */
        rc = file_on_host(ws, r, name);
        if (rc != RC_OK) {
            return rc_to_error(rc);
        }
        r->r[0] = 1;
        r->r[2] = r->r[3] = -1;
        r->r[4] = 0;
        r->r[5] = 3;
        return NULL;

    case 6:                            /* delete */
        req->cmd = C_DELETE;
        req->handle = 0;
        put_path(ws, name);
        rc = vmch_go(ws);
        if (rc == RC_NOTFOUND) {
            r->r[0] = 0;
            return NULL;
        }
        if (rc != RC_OK) {
            return rc_to_error(rc);
        }
        r->r[0] = 1;
        return NULL;

    case 1:                            /* write catalogue info */
    case 2:                            /* write load address */
    case 3:                            /* write execution address */
    case 4:                            /* write attributes */
        /* These used to return success and do nothing, so *SetType
         * appeared to work and changed nothing — and *Copy lost every
         * type it was asked to preserve.  The host now applies them: a
         * type is a rename (the type rides the host filename), a
         * datestamp is utimes(), attributes are chmod(). */
        rc = file_on_host(ws, r, name);
        return (rc == RC_OK) ? NULL : rc_to_error(rc);

    default:
        return &err_unsupported;
    }
}

_kernel_oserror *fsentry_func_handler(_kernel_swi_regs *r, void *pw)
{
    struct hostws *ws = WS_OF(pw);

    {
        _kernel_oserror *me = ensure_vmch(ws);
        if (me != NULL) {
            return me;
        }
    }

    uint32_t off, want, buflen, nbytes, n, done, load, exec, entlen, namelen;
    uint8_t *buf, *src;
    uint32_t rc;


    switch (r->r[0]) {
    case 0: case 1:                    /* *Dir / *Lib: FileSwitch stores
                                        * the prefix; nothing to do */
        return NULL;
    case 8:                            /* rename: R1 old, R2 new */
        /*
         * PRM2 2-561: FSEntry_Func 8 is Rename.  This case used to be the
         * disc-name call (which is Func 11), so *Rename wrote
         * "<6>HostFS<2>" over the caller's new-pathname string and renamed
         * nothing; FileSwitch then reported "Bad rename".  Its comment
         * cited "PRM2 FSEntry_Func 8", which is the page for Rename.
         */
        req->cmd = C_RENAME;
        req->handle = 0;
        put_two_paths(ws, (const char *)r->r[1], (const char *)r->r[2]);
        rc = vmch_go(ws);
        if (rc != RC_OK) {
            return rc_to_error(rc);
        }
        /* PRM2 2-568, on exit: "R1 = 0 if rename performed (≠0
         * otherwise)", and a non-zero R1 makes FileSwitch report "Bad
         * rename".  R1 still held the old pathname pointer, so every rename
         * that succeeded on the host was reported to the user as failed. */
        r->r[1] = 0;
        return NULL;

    case 10:                           /* boot filing system */
        /* PRM2 2-573: perform the boot action.  Nothing to do while HostFS
         * is not the boot filing system; BOOTDESIGN.md is where this
         * becomes "*Run &.!Boot" per the boot option. */
        return NULL;

    case 11: {                         /* read disc name and boot option:
                                        * <len><name><opt> at r2 (PRM2
                                        * 2-576).  R2 is not validated by
                                        * FileSwitch for this reason. */
        const char *disc = DISC_NAME;
        uint8_t *b = (uint8_t *)r->r[2];
        uint32_t k = 0;

        b[k++] = (uint8_t)DISC_NAME_LEN;
        while (disc[k - 1]) {
            b[k] = disc[k - 1];
            k++;
        }
        b[k] = 2;                       /* boot option 2 (Run), cosmetic */
        return NULL;
    }

    case 23: {                         /* CanonicaliseSpecialAndDisc */
        /*
         * PRM2 2-578.  Two phases: with R3/R4 zero, report the lengths
         * the canonical forms need; with buffers, fill them.  HostFS has
         * one disc and no special fields, so whatever the user typed, the
         * canonical answer is no special field and the disc "HostFS".
         * The buffers are FileSwitch's own, allocated from the lengths
         * phase one returned, so they are sized and valid.
         */
        const char *disc = DISC_NAME;
        uint32_t dlen = DISC_NAME_LEN;
        char *dbuf = (char *)r->r[4];
        uint32_t dsize = (uint32_t)r->r[6];
        uint32_t k;

        r->r[1] = 0;                    /* no special field ... */
        r->r[3] = 0;                    /* ... so nothing overflows */
        if (dbuf == NULL) {             /* phase 1: lengths, excluding NUL */
            r->r[2] = 1;                /* non-zero: there is a disc name */
            r->r[4] = (int)dlen;
            return NULL;
        }
        for (k = 0; k < dlen && k + 1 < dsize; k++) {
            dbuf[k] = disc[k];
        }
        if (dsize != 0) {
            dbuf[k] = 0;
        }
        r->r[2] = (int)dbuf;
        r->r[4] = (int)((dlen + 1 > dsize) ? (dlen + 1 - dsize) : 0);
        return NULL;
    }

    case 24:                           /* ResolveWildcard */
        /* PRM2 2-580: "If the filing system can not do a more efficient
         * job than FileSwitch would ... return with R4 = -1".  We cannot:
         * FileSwitch walks Func 14 and matches with RISC OS's own rules,
         * which is exactly what should happen. */
        r->r[4] = -1;
        return NULL;

    case 30:                           /* read free space: *Free */
        req->cmd = C_FS_FUNC;
        req->handle = 0;
        REQW(0) = 30;
        put_path(ws, (const char *)r->r[1]);
        rc = vmch_go(ws);
        if (rc != RC_OK) {
            return rc_to_error(rc);
        }
        r->r[0] = (int)REQW(0);         /* free space */
        r->r[1] = (int)REQW(1);         /* biggest object creatable */
        r->r[2] = (int)REQW(2);         /* disc size */
        return NULL;

    case 35:                           /* read free space in 64 bits:
                                        * OS_FSControl 55, which the Free
                                        * module's window asks first */
        req->cmd = C_FS_FUNC;
        req->handle = 0;
        REQW(0) = 35;
        put_path(ws, (const char *)r->r[1]);
        rc = vmch_go(ws);
        if (rc != RC_OK) {
            return rc_to_error(rc);
        }
        r->r[0] = (int)REQW(0);         /* free space, low word */
        r->r[1] = (int)REQW(1);         /* free space, high word */
        r->r[2] = (int)REQW(2);         /* biggest object creatable */
        r->r[3] = (int)REQW(3);         /* disc size, low word */
        r->r[4] = (int)REQW(4);         /* disc size, high word */
        return NULL;

    case 16:                           /* shutdown */
    case 17:                           /* print banner */
    case 28:                           /* WriteBootOption: no-op */
    case 32:                           /* StampImage: no-op */
        return NULL;

    case 27:                           /* ReadBootOption: 0 (SimpleFS
                                        * says never error this) */
        r->r[2] = 0;
        return NULL;

    case 14:                           /* names only           GBPB 9  */
    case 15:                           /* names + info         GBPB 10 */
    case 19: {                         /* + SIN and datestamp  GBPB 11 */
        /*
         * One directory, three record layouts (PRM2 2-572, 2-574, 2-576).
         * All three are needed: Func 24 returning R4 = -1 hands wildcards
         * to FileSwitch, which resolves them with Func 14 — so 14 answering
         * "unsupported", as it used to, made every wildcarded *Cat fail the
         * moment info-word bit 23 was set.  19 is what OS_GBPB 11 reaches.
         */
        uint32_t reason = (uint32_t)r->r[0];

        off = (uint32_t)r->r[4];
        want = (uint32_t)r->r[3];
        buf = (uint8_t *)r->r[2];
        buflen = (uint32_t)r->r[5];

        /* catalogue the whole directory into the cache */
        req->cmd = C_CAT;
        req->handle = 0;
        put_path(ws, (const char *)r->r[1]);
        rc = vmch_go(ws);
        if (rc != RC_OK) {
            return rc_to_error(rc);
        }
        nbytes = vmch_arglen(ws);
        n = nbytes >> 6;                /* 64-byte entries */
        if (n > 128) {
            n = 128;
        }
        src = req->data;
        for (uint32_t i = 0; i < n; i++) {
            struct catent *e = &catents[i];
            uint8_t *en = src + i * 64;
            e->type = ((uint32_t)en[48]) | ((uint32_t)en[49] << 8)
                    | ((uint32_t)en[50] << 16) | ((uint32_t)en[51] << 24);
            e->len = ((uint32_t)en[52]) | ((uint32_t)en[53] << 8)
                   | ((uint32_t)en[54] << 16) | ((uint32_t)en[55] << 24);
            e->attr = ((uint32_t)en[56]) | ((uint32_t)en[57] << 8)
                    | ((uint32_t)en[58] << 16) | ((uint32_t)en[59] << 24);
            /* load/exec arrive ready-made at +40/+44, so a listing is
             * dated without a FILEARGS per name */
            e->load = ((uint32_t)en[40]) | ((uint32_t)en[41] << 8)
                    | ((uint32_t)en[42] << 16) | ((uint32_t)en[43] << 24);
            e->exec = ((uint32_t)en[44]) | ((uint32_t)en[45] << 8)
                    | ((uint32_t)en[46] << 16) | ((uint32_t)en[47] << 24);
            for (int k = 0; k < 39; k++) {
                e->name[k] = en[k];
                if (!en[k]) {
                    break;
                }
            }
            e->name[39] = 0;
        }

        /* fill the caller's buffer from the continuation offset, never
         * overflowing it and counting only records written whole */
        done = 0;
        while (off < n && done < want) {
            struct catent *e = &catents[off];

            namelen = 0;
            while (e->name[namelen]) {
                namelen++;
            }
            if (reason == 14) {
                entlen = namelen + 1;                   /* packed, no align */
            } else if (reason == 15) {
                entlen = 20 + ((namelen + 1 + 3) & ~3u);
            } else {
                entlen = (29 + namelen + 1 + 3) & ~3u;  /* whole record aligned */
            }
            if (entlen > buflen) {
                break;
            }

            if (reason == 14) {
                for (uint32_t k = 0; k <= namelen; k++) {
                    buf[k] = (uint8_t)e->name[k];
                }
            } else {
                uint32_t nameat = (reason == 15) ? 20u : 29u;
                uint32_t *w = (uint32_t *)buf;

                if (e->type == 0) {
                    load = exec = 0;    /* directories carry neither */
                    e->len = 0;
                    e->attr = 3;
                } else {
                    load = e->load;
                    exec = e->exec;
                }
                w[0] = load;
                w[1] = exec;
                w[2] = e->len;
                w[3] = e->attr;
                w[4] = (e->type == 0) ? 2 : 1;   /* object type, not the
                                                  * filetype — which rides
                                                  * in load — or files read
                                                  * as directories (DWR/) */
                if (reason == 19) {
                    w[5] = 0;                   /* SIN: internal, unused */
                    /* the 5-byte instant, little-endian: exec holds its
                     * low 32 bits and load's low byte the top 8 — built
                     * bytewise so no 64-bit arithmetic is needed */
                    buf[24] = (uint8_t)exec;
                    buf[25] = (uint8_t)(exec >> 8);
                    buf[26] = (uint8_t)(exec >> 16);
                    buf[27] = (uint8_t)(exec >> 24);
                    buf[28] = (uint8_t)load;
                }
                for (uint32_t k = nameat; k < entlen; k++) {
                    uint32_t c = k - nameat;
                    buf[k] = (c <= namelen) ? (uint8_t)e->name[c] : 0;
                }
            }
            buf += entlen;
            buflen -= entlen;
            off++;
            done++;
        }
        r->r[3] = (int)done;
        r->r[4] = (off >= n) ? -1 : (int)off;
        return NULL;
    }

    default:
        return unsupported_func(ws, (uint32_t)r->r[0]);
    }
}

/* ---- module lifecycle ---------------------------------------------- */


/* The filing system information block and its information word are in
 * s.head, with the reasons for each bit: every word in the block is an
 * offset from the module base, so it registers the same from ROM or RMA.
 * hostfs_register() hands it to OS_FSControl 12. */

/* Give the workspace back and forget it.  Safe to call on a half-built
 * workspace: nothing in it needs undoing but the claim. */
static void release_workspace(void *pw)
{
    _kernel_swi_regs r;

    if (WS_OF(pw) == NULL) {
        return;
    }
    r.r[0] = 7;                          /* OS_Module 7: free, block in R2 */
    r.r[2] = (int)WS_OF(pw);
    (void)swix(XOS_Module, &r, &r);
    WS_OF(pw) = NULL;
}

_kernel_oserror *hostfs_init(const char *cmd_tail, int podule_base, void *pw)
{
    _kernel_swi_regs r;
    _kernel_oserror *e;
    struct hostws *ws;
    uint32_t i;

    (void)cmd_tail;
    (void)podule_base;

    /* The workspace first: it is where every later write goes.  OS_Module 6
     * takes the size in R3 and returns the block in R2 (Kernel/s/ModHand,
     * RMAClaim_Chunk) — a size left in R2 claims whatever R3 held. */
    r.r[0] = 6;
    r.r[3] = (int)sizeof(struct hostws);
    e = swix(XOS_Module, &r, &r);
    if (e != NULL) {
        return e;
    }
    ws = (struct hostws *)r.r[2];
    for (i = 0; i < sizeof(struct hostws); i++) {
        ((uint8_t *)ws)[i] = 0;          /* every initial value is zero */
    }
    WS_OF(pw) = ws;

    /* page-align the request block: it is exactly one page, so one
     * logical->physical translation covers every byte the device reads */
    req = (struct vmreq *)(((uint32_t)reqstore + 4095u) & ~4095u);

    /* The doorbell is mapped on first use (see ensure_vmch): mapping from
     * init fails, because the IO area is off-limits mid-load.  From the ROM
     * chain that laziness is load-bearing — init runs even earlier. */

    e = hostfs_register(pw);             /* FileSwitch's R12 for our entries */
    if (e != NULL) {
        release_workspace(pw);           /* refuse, and leave nothing behind */
        return e;                        /* loud: never register silently */
    }

    registered = 1;

    /* Free space for *ShowFree.  No Free module is no reason to refuse. */
    (void)hostfs_free_register(ws, 0);
    return NULL;
}

_kernel_oserror *hostfs_final(int fatal, int podule_base, void *pw)
{
    struct hostws *ws = WS_OF(pw);

    (void)fatal;
    (void)podule_base;
    if (ws == NULL) {
        return NULL;
    }
    if (registered) {
        _kernel_swi_regs r;
        uint32_t h;

        /* Hand back any host descriptors the device still holds — only if
         * the doorbell was ever mapped.  Killed unused, vmch is NULL, and
         * ringing it would write near address zero. */
        if (vmch != NULL) {
            for (h = 1; h <= VMCH_MAX_OPEN; h++) {
                (void)vmch_req_close(ws, h);
            }
        }
        (void)hostfs_free_register(ws, 1);
        r.r[0] = 16;                     /* FSControl_RemoveFS, by name */
        r.r[1] = (int)DISC_NAME;
        (void)swix(XOS_FSControl, &r, &r);
        registered = 0;
    }
    release_workspace(pw);
    return NULL;
}

/* ---- *commands ----------------------------------------------------- */

static void out_str(const char *text)
{
    _kernel_swi_regs r;

    r.r[0] = (int)text;
    (void)swix(XOS_Write0, &r, &r);
}

static void out_nl(void)
{
    _kernel_swi_regs r;

    (void)swix(XOS_NewLine, &r, &r);
}

static void out_hex(uint32_t v)
{
    char b[9];
    int k;

    for (k = 7; k >= 0; k--) {
        uint32_t d = v & 15u;

        b[k] = (char)(d < 10u ? '0' + d : 'A' + d - 10u);
        v >>= 4;
    }
    b[8] = 0;
    out_str(b);
}

static void out_dec(uint32_t v)
{
    char b[11];

    (void)str_dec(b, v);
    out_str(b);
}

static void out_probe(const char *label, _kernel_oserror *e)
{
    out_str(label);
    if (e != NULL) {
        out_str(" error ");
        out_hex((uint32_t)e->errnum);
        out_str(" ");
        out_str(e->errmess);
    }
}

_kernel_oserror *hostfs_commands(const char *arg_string, int argc,
                                 int cmd_no, void *pw)
{
    struct hostws *ws = WS_OF(pw);
    _kernel_swi_regs r;
    _kernel_oserror *e;

    (void)arg_string;
    (void)argc;

    /* cmd_no is the command's position in head.s's table: 0 = HostFSPing,
     * 1 = HostFSStatus.  Keep the two in step. */
    if (cmd_no == 1) {                   /* *HostFSStatus */
        uint32_t mbase = 0, msize = 0, w = (uint32_t)(unsigned long)ws;

        r.r[0] = 18;                     /* OS_Module 18: LookupName */
        r.r[1] = (int)"HostFS";
        e = swix(XOS_Module, &r, &r);
        if (e == NULL) {
            mbase = (uint32_t)r.r[3];
            msize = *(uint32_t *)(mbase - 4);   /* the size word before it */
        }
        out_probe("OS_Module 18:", e);
        out_str(" image ");
        out_hex(mbase);
        out_str("..");
        out_hex(mbase + msize);
        out_nl();

        /* The one fact R1 turns on: the workspace is a separate RMA block,
         * and nothing this module writes is inside its image. */
        out_str("workspace ");
        out_hex(w);
        out_str(" (");
        out_dec(sizeof(struct hostws));
        out_str(" bytes) ");
        out_str((w >= mbase && w < mbase + msize) ? "INSIDE THE IMAGE"
                                                   : "outside the image");
        out_str(", private word ");
        out_hex((uint32_t)(unsigned long)pw);
        out_nl();

        out_str("vmch ");
        out_hex((uint32_t)(unsigned long)vmch);
        out_str(" magic ");
        out_hex(vmch ? vmch_reg(VMCH_MAGIC / 4) : 0);
        out_str(" features ");
        out_hex(vmch ? vmch_reg(VMCH_FEATURES / 4) : 0);
        out_str(" requests ");
        out_dec(ws->w_seq);
        out_str(" registered ");
        out_dec((uint32_t)registered);
        out_nl();

        r.r[0] = 13;                     /* FSControl_LookupFS, by name */
        r.r[1] = (int)"HostFS";
        e = swix(XOS_FSControl, &r, &r);
        out_probe("FSControl 13:", e);
        if (e == NULL) {
            out_str(" R1 ");
            out_hex((uint32_t)r.r[1]);
            out_str(" R2 ");
            out_hex((uint32_t)r.r[2]);
        }
        out_nl();
        return NULL;
    }

    if (cmd_no != 0) {                   /* only HostFSPing besides */
        return &err_unsupported;
    }

    {
        _kernel_oserror *me = ensure_vmch(ws);
        if (me != NULL) {
            return me;
        }
    }
    req->cmd = C_PING;
    req->handle = 0;
    req->arglen = 4;
    req->data[0] = 'P';
    req->data[1] = 'N';
    req->data[2] = 'G';
    req->data[3] = '!';
    if (vmch_go(ws) != RC_OK || vmch_arglen(ws) != 4) {
        return &err_nodev;
    }
    return NULL;
}
