/* hostfs.c — the HostFS module body, DDE build (riscos-pi4/FSDESIGN.md).
 *
 * A filing system over the vmchannel doorbell at 0xFD400000: every
 * operation becomes one request block built in this module's statics,
 * poked into the doorbell, and answered in place by the device.
 *
 * This is the Acorn C/C++ port of the roscc body in ../hostfs.c.  cmhg
 * provides the module header, lifecycle veneers and statics relocation;
 * the seven generic FS entry veneers are cmhg-generated and call the
 * fsentry_*_handler functions here with a live register block.  The FS
 * information block for OS_FSControl 12 is built at RUNTIME (offsets
 * computed from live addresses and the module base from OS_Module 18),
 * exactly as LanManFS's LM_Declare does — see PRM2 page 2-532: "the
 * block need not exist for long, as FileSwitch takes a copy of it".
 */

#include "kernel.h"
#include <stdio.h>                       /* also provides NULL */

typedef unsigned int   uint32_t;
typedef int            int32_t;
typedef unsigned char  uint8_t;

/* ---- the doorbell ------------------------------------------------- */

/* RISC OS maps peripherals into logical space on demand, not at a
 * fixed window: OS_Memory 13 (MapIOPermanent) hands back the logical
 * base for the doorbell's physical page at 0xFE005000 (mirrored by
 * QEMU beside the system timer in the high peripheral window).  The
 * logical address is only known at runtime. */
#define VMCH_PHYS        0xFE005000u
#define VMCH_SIZE        0x1000u
#define VMCH_MAGIC      0x00
#define VMCH_FEATURES   0x08
#define VMCH_CMD        0x0C
#define VMCH_MAGIC_VALUE 0x48434D56u
#define VMCH_FEATURE_FS 0x1u
#define VMCH_FEATURE_FSENTRY  0x8u      /* v1 register-frame commands */
#define VMCH_FEATURE_VIRTADDR 0x10u     /* host walks the guest's MMU */

#define VMCH_MAX_ARG 4032   /* 64-byte header + 4032 = one 4 KB page */
#define VMCH_MAX_OPEN 16                 /* device handle slots (1-based) */

/* The request block, mirroring include/hw/misc/vmchannel.h exactly.
 * The device reads BYTE offsets; the previous H_* word indices
 * mismatched every field past CMD, so rc/arglen/handle were read from
 * bytes the device never writes.  One struct, byte-accurate, so the
 * two sides cannot drift again. */
struct vmreq {
    uint32_t cmd;                       /* +0  VMCH_HDR_CMD */
    uint32_t seq;                       /* +4  VMCH_HDR_SEQ */
    uint32_t rc;                        /* +8  VMCH_HDR_RC */
    uint32_t handle;                    /* +12 VMCH_HDR_HANDLE */
    uint32_t arglen;                    /* +16 VMCH_HDR_ARGLEN */
    uint8_t  scratch[44];               /* +20 VMCH_HDR_ARG .. +63 */
    uint8_t  data[VMCH_MAX_ARG];        /* +64 VMCH_HDR_SIZE */
};

/* word n of the scratch arg area (READ/WRITE buffer+count, SEEK
 * offset+whence, SETSIZE size) */
#define REQW(n) (*(uint32_t *)&req->scratch[(n) * 4])

/* v1: the register frame goes on the wire and the host does the work.
 * scratch[] starts at +20, which is where R0..R7 live, so REQW(n) is Rn. */
#define C_FS_GETBYTES 0x101
#define C_FS_PUTBYTES 0x102
#define C_FS_FILE     0x105
#define C_FS_FUNC     0x106
#define C_RENAME      10

#define C_PING     0
#define C_OPEN     1
#define C_CLOSE    2
#define C_READ     3
#define C_WRITE    4
#define C_SEEK     5
#define C_FILEARGS 6
#define C_CAT      7
#define C_CREATE   8
#define C_DELETE   9
#define C_SETSIZE 18

#define RC_OK        0
#define RC_NOROOT    1
#define RC_NOTFOUND  2
#define RC_ACCESS    3
#define RC_BADPATH   4
#define RC_FULL      5
#define RC_HANDLES   6
#define RC_NOTDIR    7
#define RC_ISDIR     8
#define RC_BADCMD    9
#define RC_IOERR    10
#define RC_BADADDR  11   /* a guest address would not translate */

#define O_READ   0x1u
#define O_WRITE  0x2u
#define O_CREATE 0x4u
#define O_TRUNC  0x8u

/* XSWI numbers (swis.h pulls in a large generated header; these four
 * are all this module needs) */
#define XOS_Module          0x2001E
#define XOS_FSControl       0x20029
#define XOS_Memory          0x20068

#define vmch_reg(idx) (vmch[idx])

/* The doorbell masks the request address down to 16 bytes.  Norcroft
 * has no aligned attribute, so over-allocate and line it up in init. */
/* the doorbell's logical window, from OS_Memory 13 in init */
static volatile uint32_t *vmch;

static uint8_t reqstore[sizeof(struct vmreq) + 4096];   /* room to page-align */
static struct vmreq *req;
static uint32_t req_phys;          /* the block's physical address, for the doorbell */
static uint32_t seq;

/* Per-handle state, for FSEntry_Args: the doorbell is stateless (each
 * op carries its own seek), so ptr/ext/load/exec live here instead.
 * Device handles are 1-based; 0 means no file. */
/* FileSwitch buffer size: power of two, 64..1024 (PRM 2-541).  Take the
 * maximum — the doorbell, not the copy, is what a transfer costs. */
#define HOSTFS_BUFSIZE 1024u

static uint32_t hptr[VMCH_MAX_OPEN];
static uint32_t hext[VMCH_MAX_OPEN];
static uint32_t hload[VMCH_MAX_OPEN];
static uint32_t hexec[VMCH_MAX_OPEN];

static _kernel_oserror err_notfound    = { 0x1D6, "HostFS: file not found" };
static _kernel_oserror err_access      = { 0xBD,  "HostFS: access denied" };
static _kernel_oserror err_badpath     = { 0x1E4, "HostFS: bad path" };
static _kernel_oserror err_full        = { 0x101, "HostFS: directory too big" };
static _kernel_oserror err_nodev       = { 0x1E4, "HostFS: no doorbell device" };
static _kernel_oserror err_nomap    = { 0x1E5, "HostFS: OS_Memory 13 failed" };
static _kernel_oserror err_badmagic = { 0x1E6, "HostFS: magic wrong" };
static _kernel_oserror err_nofs        = { 0x1E4, "HostFS: device has no root" };
static _kernel_oserror err_unsupported = { 0x1E8, "HostFS: unsupported operation" };
static _kernel_oserror err_oldhost = { 0x1E7,
    "HostFS: this module needs a vmchannel v1 host" };
/* Built per-call so the offset of the first unreachable byte is in the
 * message.  A short transfer is nearly always a partial-coverage bug in
 * whatever prepared the buffer, and the offset points straight at it —
 * "+258300" says the last page was missed, which a bare "not mapped"
 * would have left to a diagnostic build to discover. */
static _kernel_oserror err_retired = { 0x1EA,
    "HostFS: whole-file entry called despite dontuseload/dontusesave" };
static _kernel_oserror err_badaddr_buf;

static _kernel_oserror *badaddr_at(uint32_t off)
{
    err_badaddr_buf.errnum = 0x1E9;
    sprintf(err_badaddr_buf.errmess,
            "HostFS: transfer buffer not mapped at +%u", (unsigned int)off);
    return &err_badaddr_buf;
}

static _kernel_oserror *rc_to_error(uint32_t rc)
{
    switch (rc) {
    case RC_OK: return NULL;
    case RC_NOTFOUND: return &err_notfound;
    case RC_ACCESS: case RC_HANDLES: return &err_access;
    case RC_BADPATH: return &err_badpath;
    case RC_FULL: return &err_full;
    case RC_NOROOT: return &err_nofs;
    default: return &err_unsupported;
    }
}

/* ---- the transport -------------------------------------------------- */

static uint32_t vmch_go(void)
{
    req->seq = ++seq;
    req->rc = 0xFFFFFFFFu;             /* poison: an unanswered request stays visible */
    vmch_reg(VMCH_CMD / 4) = req_phys; /* the device DMAs physical, not logical */
    return req->rc;
}

static uint32_t vmch_arglen(void)
{
    return req->arglen;
}

/* path: NUL-terminated RISC OS path into the arg area */
static void put_two_paths(const char *a, const char *b)
{
    char *arg = (char *)req->data;
    uint32_t i = 0, j;

    for (j = 0; (unsigned char)a[j] >= 32 && i < VMCH_MAX_ARG - 2; j++) {
        arg[i++] = a[j];
    }
    arg[i++] = '\n';                  /* the device splits on this */
    for (j = 0; (unsigned char)b[j] >= 32 && i < VMCH_MAX_ARG - 1; j++) {
        arg[i++] = b[j];
    }
    arg[i] = 0;
    req->arglen = i;
}

static void put_path(const char *path)
{
    char *arg = (char *)req->data;
    uint32_t i = 0;

    while (path[i] && i < VMCH_MAX_ARG - 1) {
        arg[i] = path[i];
        i++;
    }
    arg[i] = 0;
    req->arglen = i;
}

/* one catalogue entry as cached from CAT */
struct catent {
    uint32_t load, exec, len, attr, type;
    char name[40];
};
static struct catent catents[128];

/* FILEARGS response: size, type, attr, cs_lo, cs_hi, load, exec.
 * load and exec are computed host-side; nothing in this module
 * knows how a load address is put together any more. */
static uint32_t info_of(const char *path, uint32_t *size, uint32_t *type,
                        uint32_t *attr, uint32_t *cs_lo, uint32_t *cs_hi,
                        uint32_t *load, uint32_t *exec)
{
    uint32_t rc;
    uint32_t *resp;

    req->cmd = C_FILEARGS;
    req->handle = 0;
    put_path(path);
    rc = vmch_go();
    if (rc != RC_OK) {
        return rc;
    }
    resp = (uint32_t *)req->data;
    *size = resp[0];
    *type = resp[1];
    *attr = resp[2];
    *cs_lo = resp[3];
    *cs_hi = resp[4];
    *load = resp[5];                 /* computed host-side: the module */
    *exec = resp[6];                 /* never has to know the format */
    return RC_OK;
}

/* object type in the OS_File sense: 1 file, 2 directory, 0 none */
static uint32_t objtype_of(uint32_t rc, uint32_t type)
{
    if (rc != RC_OK) {
        return 0;
    }
    return type == 0 ? 2 : 1;
}

/* FSEntry_File on the host: R0 reason, R2 load, R3 exec, R5 attr, and the
 * path inline.  The host decides what they mean — including that setting
 * a type renames the file — so this passes them through and nothing
 * more. */
static uint32_t file_on_host(_kernel_swi_regs *r, const char *name)
{
    req->cmd = C_FS_FILE;
    req->handle = 0;
    REQW(0) = (uint32_t)r->r[0];
    REQW(2) = (uint32_t)r->r[2];
    REQW(3) = (uint32_t)r->r[3];
    REQW(5) = (uint32_t)r->r[5];
    put_path(name);
    return vmch_go();
}

static uint32_t vmch_req_close(uint32_t h)
{
    req->cmd = C_CLOSE;
    req->handle = h;
    req->arglen = 0;
    return vmch_go();
}

/* ---- guest buffer plumbing ------------------------------------------ */

/* OS_Memory 0: translate one logical address to physical.  The device
 * DMAs physical memory, so every guest buffer address must go through
 * this before it enters a request block. */
struct pbrec {
    int32_t  page;                  /* physical page number */
    uint32_t log;                   /* logical address */
    uint32_t phys;                  /* physical address */
};


/* Move n bytes between the file (at file offset ptr) and guest memory
 * at logical address mem.  Chunks never cross a 4KB page, so each
 * translated address stays valid for the whole chunk.  Returns bytes
 * moved; the per-handle pointer is maintained by the caller. */
/*
 * The host reads the guest's translation tables as they stand and cannot
 * fault a page in.  RISC OS maps application space lazily, so a buffer
 * the client has only just claimed is present as far as the client has
 * touched it and no further — measured: an untouched 256 KiB DIM
 * translates for 252 bytes, to the end of its first page, and no more.
 *
 * Touch it from here, one byte per page, in guest code.  That is the
 * same access any other filing system makes when it writes the caller's
 * buffer, and it goes through the guest's own abort handler, which is
 * what maps the page.  A byte is read rather than written so the buffer
 * is not disturbed if the transfer then fails.
 *
 * Safe only because this is the GBPB path.  PRM2 warns for FSEntry_Func
 * 9, 10 and 11 that "the buffer pointed to by R2 will not have been
 * validated with OS_ValidateAddress, because FileSwitch doesn't know how
 * big the buffer has to be" — and carries no such warning for
 * GetBytes/PutBytes, where the count is in R3 and FileSwitch does know.
 * So a wild pointer should not reach here, only an in-slot page the
 * client has not yet faulted in.  If one ever does, this aborts, and the
 * fix is an OS_ValidateAddress check before the loop with the BadWrt
 * error the PRM names.  Those Func entries must validate for themselves
 * when they are written.
 */
static void touch_pages(uint32_t mem, uint32_t n)
{
    volatile const uint8_t *p = (volatile const uint8_t *)mem;
    uint32_t i;
    uint8_t sink = 0;

    if (n == 0) {
        return;
    }
    for (i = 0; i < n; i += 0x1000u) {
        sink = (uint8_t)(sink | p[i]);
    }
    sink = (uint8_t)(sink | p[n - 1]);   /* the final partial page */
    (void)sink;
}

static uint32_t xfer_once(uint32_t h, uint32_t ptr, uint32_t mem, uint32_t n,
                          int is_write)
{
    /* One round trip, whatever the size or alignment.  `mem` goes on the
     * wire as the guest's own logical address and the host walks the MMU
     * to reach it; `ptr` is the file offset, so there is no seek.
     *
     * This replaces a loop that split every transfer at 4 KiB, called
     * OS_Memory per chunk to get a physical address, and issued a SEEK
     * before each READ — two doorbells per page, and on a failed
     * translation it used the logical address as if it were physical.
     * A 256 KiB read cost 130 round trips; it now costs one. */
    req->cmd = (uint32_t)(is_write ? C_FS_PUTBYTES : C_FS_GETBYTES);
    req->arglen = 0;
    REQW(1) = h;
    REQW(2) = mem;
    REQW(3) = n;
    REQW(4) = ptr;
    {
        uint32_t rc = vmch_go();

        if (rc == RC_OK) {
            return n;
        }
        /* On a partly-mapped buffer the host reports in R3 how far the
         * translation got.  Hand that back so the caller can tell a
         * short transfer from nothing at all. */
        if (rc == RC_BADADDR) {
            return REQW(3);
        }
        return 0;
    }
}

static uint32_t xfer(uint32_t h, uint32_t ptr, uint32_t mem, uint32_t n,
                     int is_write)
{
    uint32_t moved = xfer_once(h, ptr, mem, n, is_write);

    if (moved != n) {
        /* Short: the tail of the buffer is not mapped yet.  Fault it in
         * and go again.  One retry is enough — after touching, every
         * page of the buffer is present — and the common case never
         * gets here, so the fast path stays at one doorbell. */
        touch_pages(mem, n);
        moved = xfer_once(h, ptr, mem, n, is_write);
    }
    return moved;
}


/* Map the doorbell on first use: OS_Memory 13 fails when called from
 * a module's init (the IO dynamic area is off-limits mid-module-load),
 * but works from any normal context, as the status probe proved.
 * vmch is published only after magic and features validate, so a map
 * onto a wrong page can never be cached. */
static _kernel_oserror *ensure_vmch(void)
{
    _kernel_swi_regs r;
    _kernel_oserror *e;
    volatile uint32_t *v;

    if (vmch) {
        return NULL;
    }
    r.r[0] = 13;                     /* OS_Memory: MapIOPermanent */
    r.r[1] = (int)VMCH_PHYS;
    r.r[2] = (int)VMCH_SIZE;
    e = _kernel_swi(XOS_Memory, &r, &r);
    if (e != NULL || r.r[3] == 0) {
        return &err_nomap;
    }
    v = (volatile uint32_t *)r.r[3];
    if (v[VMCH_MAGIC / 4] != VMCH_MAGIC_VALUE) {
        return &err_badmagic;
    }
    if (!(v[VMCH_FEATURES / 4] & VMCH_FEATURE_FS)) {
        return &err_nofs;
    }
    /* v1 is required, not preferred.  The v0 transfer path translated
     * addresses in the guest and fell back to the identity mapping when
     * OS_Memory failed, writing file data wherever that landed; falling
     * back to it silently would be worse than not loading. */
    if ((v[VMCH_FEATURES / 4] & (VMCH_FEATURE_FSENTRY | VMCH_FEATURE_VIRTADDR))
        != (VMCH_FEATURE_FSENTRY | VMCH_FEATURE_VIRTADDR)) {
        return &err_oldhost;
    }
    /* The device DMAs physical addresses.  The block is one page-aligned
     * page, so a single OS_Memory 0 translation covers all of it. */
    {
        struct pbrec pb;
        _kernel_swi_regs pr;
        pb.page = -1;
        pb.log = (uint32_t)req;
        pb.phys = 0;
        pr.r[0] = (1u << 9) | (1u << 13);
        pr.r[1] = (int)&pb;
        pr.r[2] = 1;
        if (_kernel_swi(XOS_Memory, &pr, &pr) != NULL || pb.phys == 0) {
            return &err_nomap;
        }
        req_phys = pb.phys;
    }
    vmch = v;
    return NULL;
}

/* ---- FS entry handlers: r->r[] is the caller's register frame ------- */

_kernel_oserror *fsentry_open_handler(_kernel_swi_regs *r, void *pw)
{
    {
        _kernel_oserror *me = ensure_vmch();
        if (me != NULL) {
            return me;
        }
    }

    uint32_t mode = (uint32_t)r->r[0];
    const char *name = (const char *)r->r[1];
    uint32_t flags = O_READ;
    uint32_t rc, h, idx, load, exec;
    uint32_t size = 0, type = 0xFFF, attr = 0, cs_lo = 0, cs_hi = 0;

    (void)pw;

    /* FSEntry_Open modes (PRM2 2-542): 0 read, 2 update; 1 is the
     * RISC OS 2 create+update, kept for compatibility.  FileSwitch
     * pre-creates via FSEntry_File 7 for OPENOUT. */
    if (mode == 1) {
        flags = O_WRITE | O_CREATE | O_TRUNC;
    } else if (mode == 2) {
        flags = O_WRITE | O_READ;
    }

    req->cmd = C_OPEN;
    req->handle = flags;
    put_path(name);
    rc = vmch_go();
    if (rc != RC_OK) {
        return rc_to_error(rc);
    }
    h = req->handle;
    if (h == 0 || h > VMCH_MAX_OPEN) {
        return &err_access;             /* 0 means "no file open" */
    }
    idx = h - 1;

    rc = info_of(name, &size, &type, &attr, &cs_lo, &cs_hi, &load, &exec);
    if (rc == RC_NOTFOUND) {
        size = 0;                       /* newly created file */
        type = 0xFFF;
    } else if (rc != RC_OK) {
        vmch_req_close(h);
        return rc_to_error(rc);
    }

    hptr[idx] = 0;
    hext[idx] = size;
    hload[idx] = load;
    hexec[idx] = exec;

    /* File information word, PRM 2-542.  Bit 28 (unbuffered GBPB) must
     * stay CLEAR: it tells FileSwitch the FS_gbpb entry handles multi-
     * byte transfers itself, and this module leaves that entry (info
     * block word 10) zero, so setting it dispatched every transfer into
     * nothing.  Buffered instead: R2 carries a buffer size, which
     * PRM 2-541 requires to be a power of two between 64 and 1024, and
     * FileSwitch then drives GetBytes/PutBytes in whole blocks and
     * tracks PTR#/EXT# for us. */
    r->r[0] = (int)((1u << 31) | (1u << 30) |
                    ((type == 0) ? (1u << 29) : 0u));   /* 29: directory */
    r->r[1] = (int)h;
    r->r[2] = HOSTFS_BUFSIZE;
    r->r[3] = (int)((type == 0) ? 0 : size);            /* extent */
    /* allocated space: must be a multiple of the buffer size */
    r->r[4] = (int)((size + (HOSTFS_BUFSIZE - 1u)) & ~(HOSTFS_BUFSIZE - 1u));
    return NULL;
}

_kernel_oserror *fsentry_get_handler(_kernel_swi_regs *r, void *pw)
{
    {
        _kernel_oserror *me = ensure_vmch();
        if (me != NULL) {
            return me;
        }
    }

    uint32_t h = (uint32_t)r->r[1];
    uint32_t mem = (uint32_t)r->r[2];
    uint32_t n = (uint32_t)r->r[3];
    uint32_t ptr = (uint32_t)r->r[4];
    uint32_t moved;
    int idx = (int)h - 1;

    (void)pw;

    if (idx < 0 || idx >= VMCH_MAX_OPEN) {
        return &err_access;
    }
    moved = xfer(h, ptr, mem, n, 0);
    hptr[idx] = ptr + moved;
    /* Buffered GetBytes has no exit registers (PRM 2-544), so the only
     * way to report a failure is to return an error — and it must be
     * reported.  Reading past the end of the file is NOT this case: the
     * host zero-fills the tail and still delivers the full count, so a
     * short `moved` means the guest buffer would not translate, and the
     * bytes the caller can see are not the file's.  Saying nothing here
     * once produced "0 bytes not transferred" over a buffer holding 252
     * good bytes and 261892 stale ones. */
    if (moved != n) {
        return badaddr_at(moved);
    }
    return NULL;
}

_kernel_oserror *fsentry_put_handler(_kernel_swi_regs *r, void *pw)
{
    {
        _kernel_oserror *me = ensure_vmch();
        if (me != NULL) {
            return me;
        }
    }

    uint32_t h = (uint32_t)r->r[1];
    uint32_t mem = (uint32_t)r->r[2];
    uint32_t n = (uint32_t)r->r[3];
    uint32_t ptr = (uint32_t)r->r[4];
    uint32_t moved;
    int idx = (int)h - 1;

    (void)pw;

    if (idx < 0 || idx >= VMCH_MAX_OPEN) {
        return &err_access;
    }
    moved = xfer(h, ptr, mem, n, 1);
    hptr[idx] = ptr + moved;
    if (hptr[idx] > hext[idx]) {
        hext[idx] = hptr[idx];
    }
    if (moved != n) {           /* see fsentry_get_handler */
        return badaddr_at(moved);
    }
    return NULL;
}

_kernel_oserror *fsentry_args_handler(_kernel_swi_regs *r, void *pw)
{
    {
        _kernel_oserror *me = ensure_vmch();
        if (me != NULL) {
            return me;
        }
    }

    uint32_t h = (uint32_t)r->r[1];
    int idx = (int)h - 1;

    (void)pw;

    if (idx < 0 || idx >= VMCH_MAX_OPEN) {
        return &err_access;
    }

    /* Reason numbers are FileSwitch's internal ones (LowFSI:212), not
     * the OS_Args SWI numbers: flush arrives as 6, not 255. */
    switch (r->r[0]) {
    case 0:                            /* ReadPTR */
        r->r[2] = (int)hptr[idx];
        return NULL;
    case 1:                            /* SetPTR: host fseek extends
                                        * lazily, so just accept it */
        hptr[idx] = (uint32_t)r->r[2];
        if (hptr[idx] > hext[idx]) {
            hext[idx] = hptr[idx];
        }
        return NULL;
    case 2:                            /* ReadEXT */
        r->r[2] = (int)hext[idx];
        return NULL;
    case 3: {                          /* SetEXT: real truncate/extend */
        uint32_t ne = (uint32_t)r->r[2];

        req->cmd = C_SETSIZE;
        req->handle = h;
        req->arglen = 0;
        REQW(0) = ne;
        if (vmch_go() != RC_OK) {
            return &err_access;
        }
        hext[idx] = ne;
        if (hptr[idx] > ne) {
            hptr[idx] = ne;
        }
        return NULL;
    }
    case 4:                            /* ReadSize: allocated size */
        r->r[2] = (int)((hext[idx] + 0xFFFu) & ~0xFFFu);
        return NULL;
    case 5:                            /* EOFCheck: -1 at EOF */
        r->r[2] = (hptr[idx] >= hext[idx]) ? -1 : 0;
        return NULL;
    case 6:                            /* Flush: hand back load/exec */
    case 9:                            /* ReadLoadExec */
        r->r[2] = (int)hload[idx];
        r->r[3] = (int)hexec[idx];
        return NULL;
    case 7:                            /* EnsureSize: no-op */
    case 10:                           /* ImageStampIs: image FS only */
        return NULL;
    default:                           /* incl. 8 WriteZeroes (buffered
                                        * only) and 11 IOCtl */
        return &err_unsupported;
    }
}

_kernel_oserror *fsentry_close_handler(_kernel_swi_regs *r, void *pw)
{
    {
        _kernel_oserror *me = ensure_vmch();
        if (me != NULL) {
            return me;
        }
    }

    uint32_t rc = vmch_req_close((uint32_t)r->r[1]);
    int idx = (int)r->r[1] - 1;

    (void)pw;
    if (idx >= 0 && idx < VMCH_MAX_OPEN) {
        hptr[idx] = hext[idx] = 0;
    }
    return (rc == RC_OK) ? NULL : rc_to_error(rc);
}

_kernel_oserror *fsentry_file_handler(_kernel_swi_regs *r, void *pw)
{
    {
        _kernel_oserror *me = ensure_vmch();
        if (me != NULL) {
            return me;
        }
    }

    uint32_t reason = (uint32_t)r->r[0];
    const char *name = (const char *)r->r[1];
    uint32_t size, type, attr, cs_lo, cs_hi, rc, load, exec;

    (void)pw;

    switch (reason) {
    case 5:                            /* read catalogue info */
    case 9:                            /* ...without length */
        rc = info_of(name, &size, &type, &attr, &cs_lo, &cs_hi, &load, &exec);
        {
            uint32_t obj = objtype_of(rc, type);

            r->r[0] = (int)obj;
            if (!obj) {
                return NULL;
            }
            if (obj == 2) {
                load = exec = 0;
                size = 0;
                attr = 3;
            } else {
                        }
            r->r[2] = (int)load;
            r->r[3] = (int)exec;
            r->r[4] = (int)size;
            r->r[5] = (int)attr;
        }
        return NULL;

    /*
     * fsfile_Load (0xFF) and fsfile_Save (0) are retired: information
     * word bits 20 and 19 tell FileSwitch to build *Load and *Save out
     * of Open/GetBytes/PutBytes/Close instead.  Answered rather than
     * deleted, so that if FileSwitch ever calls them anyway the failure
     * is named instead of mysterious.
     */
    case 0xFF:                         /* load  */
    case 0:                            /* save  */
        return &err_retired;

    case 7:                            /* create empty, of the type in R2 */
        rc = file_on_host(r, name);
        if (rc != RC_OK) {
            return rc_to_error(rc);
        }
        r->r[0] = 1;
        r->r[2] = r->r[3] = -1;
        r->r[4] = 0;
        r->r[5] = 3;
        return NULL;

    case 6:                            /* delete */
        req->cmd = C_DELETE;
        req->handle = 0;
        put_path(name);
        rc = vmch_go();
        if (rc == RC_NOTFOUND) {
            r->r[0] = 0;
            return NULL;
        }
        if (rc != RC_OK) {
            return rc_to_error(rc);
        }
        r->r[0] = 1;
        return NULL;

    case 1:                            /* write catalogue info */
    case 2:                            /* write load address */
    case 3:                            /* write execution address */
    case 4:                            /* write attributes */
        /* These used to return success and do nothing, so *SetType
         * appeared to work and changed nothing — and *Copy lost every
         * type it was asked to preserve.  The host now applies them: a
         * type is a rename (the type rides the host filename), a
         * datestamp is utimes(), attributes are chmod(). */
        rc = file_on_host(r, name);
        return (rc == RC_OK) ? NULL : rc_to_error(rc);

    default:
        return &err_unsupported;
    }
}

_kernel_oserror *fsentry_func_handler(_kernel_swi_regs *r, void *pw)
{
    {
        _kernel_oserror *me = ensure_vmch();
        if (me != NULL) {
            return me;
        }
    }

    uint32_t off, want, buflen, nbytes, n, done, load, exec, entlen, namelen;
    uint8_t *buf, *src;
    uint32_t rc;

    (void)pw;

    switch (r->r[0]) {
    case 0: case 1:                    /* *Dir / *Lib: FileSwitch stores
                                        * the prefix; nothing to do */
        return NULL;
    case 8:                            /* rename: R1 old, R2 new */
        /*
         * PRM2 2-561: FSEntry_Func 8 is Rename.  This case used to be the
         * disc-name call (which is Func 11), so *Rename wrote
         * "<6>HostFS<2>" over the caller's new-pathname string and renamed
         * nothing; FileSwitch then reported "Bad rename".  Its comment
         * cited "PRM2 FSEntry_Func 8", which is the page for Rename.
         */
        req->cmd = C_RENAME;
        req->handle = 0;
        put_two_paths((const char *)r->r[1], (const char *)r->r[2]);
        rc = vmch_go();
        if (rc != RC_OK) {
            return rc_to_error(rc);
        }
        /* PRM2 2-568, on exit: "R1 = 0 if rename performed (≠0
         * otherwise)", and a non-zero R1 makes FileSwitch report "Bad
         * rename".  R1 still held the old pathname pointer, so every rename
         * that succeeded on the host was reported to the user as failed. */
        r->r[1] = 0;
        return NULL;

    case 10:                           /* boot filing system */
        /* PRM2 2-573: perform the boot action.  Nothing to do while HostFS
         * is not the boot filing system; BOOTDESIGN.md is where this
         * becomes "*Run &.!Boot" per the boot option. */
        return NULL;

    case 11: {                         /* read disc name and boot option:
                                        * <len><name><opt> at r2 (PRM2
                                        * 2-576).  R2 is not validated by
                                        * FileSwitch for this reason. */
        static const char disc[] = "HostFS";
        uint8_t *b = (uint8_t *)r->r[2];
        uint32_t k = 0;

        b[k++] = sizeof(disc) - 1;
        while (disc[k - 1]) {
            b[k] = disc[k - 1];
            k++;
        }
        b[k] = 2;                       /* boot option 2 (Run), cosmetic */
        return NULL;
    }

    case 30:                           /* read free space: *Free */
        req->cmd = C_FS_FUNC;
        req->handle = 0;
        REQW(0) = 30;
        put_path((const char *)r->r[1]);
        rc = vmch_go();
        if (rc != RC_OK) {
            return rc_to_error(rc);
        }
        r->r[0] = (int)REQW(0);         /* free space */
        r->r[1] = (int)REQW(1);         /* biggest object creatable */
        r->r[2] = (int)REQW(2);         /* disc size */
        return NULL;

    case 16:                           /* shutdown */
    case 17:                           /* print banner */
    case 28:                           /* WriteBootOption: no-op */
    case 32:                           /* StampImage: no-op */
        return NULL;

    case 27:                           /* ReadBootOption: 0 (SimpleFS
                                        * says never error this) */
        r->r[2] = 0;
        return NULL;

    case 14:                           /* read names: FileSwitch can get
                                        * names from the info form */
        return &err_unsupported;

    case 15: {                         /* read names + info */
        off = (uint32_t)r->r[4];
        want = (uint32_t)r->r[3];
        buf = (uint8_t *)r->r[2];
        buflen = (uint32_t)r->r[5];

        /* catalogue the whole directory into the cache */
        req->cmd = C_CAT;
        req->handle = 0;
        put_path((const char *)r->r[1]);
        rc = vmch_go();
        if (rc != RC_OK) {
            return rc_to_error(rc);
        }
        nbytes = vmch_arglen();
        n = nbytes / 64;
        if (n > 128) {
            n = 128;
        }
        src = req->data;
        for (uint32_t i = 0; i < n; i++) {
            struct catent *e = &catents[i];
            uint8_t *en = src + i * 64;
            e->type = ((uint32_t)en[48]) | ((uint32_t)en[49] << 8)
                    | ((uint32_t)en[50] << 16) | ((uint32_t)en[51] << 24);
            e->len = ((uint32_t)en[52]) | ((uint32_t)en[53] << 8)
                   | ((uint32_t)en[54] << 16) | ((uint32_t)en[55] << 24);
            e->attr = ((uint32_t)en[56]) | ((uint32_t)en[57] << 8)
                    | ((uint32_t)en[58] << 16) | ((uint32_t)en[59] << 24);
            /* load/exec arrive ready-made at +40/+44, so a listing is
             * dated without a FILEARGS per name */
            e->load = ((uint32_t)en[40]) | ((uint32_t)en[41] << 8)
                    | ((uint32_t)en[42] << 16) | ((uint32_t)en[43] << 24);
            e->exec = ((uint32_t)en[44]) | ((uint32_t)en[45] << 8)
                    | ((uint32_t)en[46] << 16) | ((uint32_t)en[47] << 24);
            for (int k = 0; k < 39; k++) {
                e->name[k] = en[k];
                if (!en[k]) {
                    break;
                }
            }
            e->name[39] = 0;
        }

        /* fill the caller's buffer from the continuation offset */
        done = 0;
        while (off < n && done < want) {
            struct catent *e = &catents[off];
            namelen = 0;
            while (e->name[namelen]) {
                namelen++;
            }
            entlen = 20 + ((namelen + 1 + 3) & ~3u);
            if (entlen > buflen) {
                break;
            }
            if (e->type == 0) {
                load = exec = 0;        /* directories carry neither */
                e->len = 0;
                e->attr = 3;
            } else {
                load = e->load;
                exec = e->exec;
            }
            {
                uint32_t *w = (uint32_t *)buf;
                w[0] = load;
                w[1] = exec;
                w[2] = e->len;
                w[3] = e->attr;
                w[4] = (e->type == 0) ? 2 : 1;   /* object type: dir / file
                                                  * (the filetype rides
                                                  * load in w[0]) — not the
                                                  * filetype, or *Cat and
                                                  * the Filer read files as
                                                  * directories (DWR/) */
            }
            for (uint32_t k = 0; k < ((namelen + 1 + 3) & ~3u); k++) {
                buf[20 + k] = k <= namelen ? e->name[k] : 0;
            }
            buf += entlen;
            buflen -= entlen;
            off++;
            done++;
        }
        r->r[3] = (int)done;
        r->r[4] = (off >= n) ? -1 : (int)off;
        return NULL;
    }

    default:
        return &err_unsupported;
    }
}

/* ---- module lifecycle ---------------------------------------------- */

static int registered;

/* the cmhg-generated FS entry veneers, defined in the header object */
extern void fsentry_open(void);
extern void fsentry_get(void);
extern void fsentry_put(void);
extern void fsentry_args(void);
extern void fsentry_close(void);
extern void fsentry_file(void);
extern void fsentry_func(void);

static const char FilingSystemName[] = "HostFS";
static void *hostfs_pw;

#define OUR_FS_NUMBER 220
#define INFO_FSFILE9_NOLEN 0x04000000u  /* LowFSI:121 fsinfo_fsfilereadinfonolen */
/* LowFSI: fsinfo_dontuseload (bit 20) and fsinfo_dontusesave (bit 19).
 * "FileSwitch does *Load with Open, GBPB, close" — Doc/SimpleFS
 * recommends both for a network-flavour filing system, and they are what
 * makes whole-file and streaming one code path instead of two that can
 * disagree.  They did disagree: *Copy worked while *Type and BGET#
 * returned garbage, because only the whole-file path was exercised. */
#define INFO_DONTUSESAVE   0x00080000u
#define INFO_DONTUSELOAD   0x00100000u
#define INFO_WORD (OUR_FS_NUMBER | (16u << 8) | INFO_FSFILE9_NOLEN \
                   | INFO_DONTUSELOAD | INFO_DONTUSESAVE)

_kernel_oserror *hostfs_init(const char *cmd_tail, int podule_base, void *pw)
{
    _kernel_swi_regs r;
    _kernel_oserror *e;
    uint32_t base;
    unsigned int InfoBlk[12];

    (void)cmd_tail;
    (void)podule_base;

    /* page-align the request block: it is exactly one page, so one
     * logical->physical translation covers every byte the device reads */
    req = (struct vmreq *)(((uint32_t)reqstore + 4095u) & ~4095u);

    /* The doorbell is mapped on first use (see ensure_vmch): mapping
     * from init fails because the IO area is off-limits mid-load. */

    /* The FSInfo offsets are computed as live_address - base and
     * FileSwitch stores base and adds it back (FSCtrl2), so any
     * self-consistent base works; base 0 makes the offsets plain
     * absolute addresses.  (OS_Module 18 cannot be used here: the
     * module is not yet in the chain while its own init runs.) */
    base = 0;

    /* The filing system information block, built at runtime from live
     * addresses (PRM2 2-532: FileSwitch copies it immediately) */
    InfoBlk[0]  = (unsigned int)((unsigned long)FilingSystemName - base);
    InfoBlk[1]  = 0;                     /* no startup banner */
    InfoBlk[2]  = (unsigned int)((unsigned long)fsentry_open  - base);
    InfoBlk[3]  = (unsigned int)((unsigned long)fsentry_get   - base);
    InfoBlk[4]  = (unsigned int)((unsigned long)fsentry_put   - base);
    InfoBlk[5]  = (unsigned int)((unsigned long)fsentry_args  - base);
    InfoBlk[6]  = (unsigned int)((unsigned long)fsentry_close - base);
    InfoBlk[7]  = (unsigned int)((unsigned long)fsentry_file  - base);
    InfoBlk[8]  = INFO_WORD;             /* fs 220, 16 streams, File 9 */
    InfoBlk[9]  = (unsigned int)((unsigned long)fsentry_func  - base);
    InfoBlk[10] = 0;                     /* gbpb: FileSwitch synthesises */
    InfoBlk[11] = 0;

    r.r[0] = 12;                         /* FSControl_AddFS */
    r.r[1] = (int)base;
    r.r[2] = (int)((unsigned long)InfoBlk - base);
    r.r[3] = (int)pw;
    e = _kernel_swi(XOS_FSControl, &r, &r);
    if (e != NULL) {
        return e;                        /* loud: never register silently */
    }

    registered = 1;
    hostfs_pw = pw;
    return NULL;
}

_kernel_oserror *hostfs_final(int fatal, int podule_base, void *pw)
{
    (void)fatal;
    (void)podule_base;
    (void)pw;
    if (registered) {
        _kernel_swi_regs r;
        uint32_t h;

        /* hand back any host descriptors the device still holds */
        for (h = 1; h <= VMCH_MAX_OPEN; h++) {
            (void)vmch_req_close(h);
        }
        r.r[0] = 16;                     /* FSControl_RemoveFS, by name */
        r.r[1] = (int)FilingSystemName;
        (void)_kernel_swi(XOS_FSControl, &r, &r);
        registered = 0;
    }
    return NULL;
}

_kernel_oserror *hostfs_commands(const char *arg_string, int argc,
                                 int cmd_no, void *pw)
{
    _kernel_swi_regs r;
    _kernel_oserror *e;

    (void)arg_string;
    (void)argc;
    (void)pw;

    /* cmd_no is cmhg's index into the command-keyword-table, in table
     * order: 0 = HostFSPing, 1 = HostFSStatus.  Keep this switch and
     * dde/cmhg/HostFS in lockstep if the table is reordered. */
    if (cmd_no == 1) {                   /* *HostFSStatus */
        printf("HostFS vmch=%08X magic=%08X features=%08X registered=%d pw=%08X\r\n",
               (unsigned int)(unsigned long)vmch,
               vmch ? vmch_reg(VMCH_MAGIC / 4) : 0xDEAD,
               vmch ? vmch_reg(VMCH_FEATURES / 4) : 0xDEAD,
               registered, (unsigned int)pw);
        r.r[0] = 13;                     /* re-run the mapping probe */
        r.r[1] = (int)VMCH_PHYS;
        r.r[2] = (int)VMCH_SIZE;
        e = _kernel_swi(XOS_Memory, &r, &r);
        printf("OS_Memory 13: e=%d R3=%08X\r\n", e != NULL, r.r[3]);
        r.r[0] = 18;                     /* OS_Module 18: LookupName (not
                                          * 0 = Run, which enters this
                                          * resident module as an app and
                                          * aborts) */
        r.r[1] = (int)"HostFS";
        e = _kernel_swi(XOS_Module, &r, &r);
        printf("OS_Module 18: e=%d R1(num)=%08X R3(base)=%08X R4(pw)=%08X\r\n",
               e != NULL, r.r[1], r.r[3], r.r[4]);
        r.r[0] = 13;                     /* FSControl_LookupFS, by name */
        r.r[1] = (int)"HostFS";
        e = _kernel_swi(XOS_FSControl, &r, &r);
        printf("FSControl 13: e=%d", e != NULL);
        if (e != NULL) {
            printf(" num=%d %s", e->errnum, e->errmess);
        } else {
            printf(" R1=%08X R2=%08X R3=%08X", r.r[1], r.r[2], r.r[3]);
        }
        printf("\r\n");
        r.r[0] = 20;                     /* FSControl_ReadModuleBase */
        r.r[1] = (int)"HostFS";
        e = _kernel_swi(XOS_FSControl, &r, &r);
        printf("FSControl 20: e=%d", e != NULL);
        if (e != NULL) {
            printf(" num=%d %s", e->errnum, e->errmess);
        } else {
            printf(" R1=%08X", r.r[1]);
        }
        printf("\r\n");
        return NULL;
    }

    if (cmd_no != 0) {                   /* only HostFSPing besides */
        return &err_unsupported;
    }

    {
        _kernel_oserror *me = ensure_vmch();
        if (me != NULL) {
            return me;
        }
    }
    req->cmd = C_PING;
    req->handle = 0;
    req->arglen = 4;
    req->data[0] = 'P';
    req->data[1] = 'N';
    req->data[2] = 'G';
    req->data[3] = '!';
    if (vmch_go() != RC_OK || vmch_arglen() != 4) {
        return &err_nodev;
    }
    return NULL;
}
