; HostFSFiler cmhg control file (DDE build).  Sprint 6D.
; A desktop filer for HostFS on the RAMFSFiler pattern: a
; Desktop_HostFSFiler command the desktop starts as a Wimp task, which
; puts a HostFS disc on the icon bar and opens HostFS:$ when clicked.

title-string:            HostFSFiler
help-string:             HostFSFiler 0.01 (11 Sep 2026)

initialisation-code:     hostfsfiler_init
finalisation-code:       hostfsfiler_final

service-call-handler:    hostfsfiler_service 0x4B 0x4F 0x27

command-keyword-table:   hostfsfiler_command
  Desktop_HostFSFiler(min-args:0, max-args:0, invalid-syntax:"Use *Desktop"),
  HostFSFiler(min-args:0, max-args:0, invalid-syntax:"Syntax: *HostFSFiler")
