/* hostfsfiler.c — the HostFS icon-bar filer (DDE build).  Sprint 6D.
 *
 * A desktop filer module on the RAMFSFiler pattern.  It provides a
 * Desktop_HostFSFiler command; the desktop starts that as a Wimp task
 * (it Wimp_StartTasks every Desktop_* command at *Desktop time), and
 * the task puts a HostFS disc on the icon bar.  Clicking it opens
 * HostFS:$ — the desktop's own Filer draws the directory window, since
 * HostFS answers the FSEntry_Func calls a Filer makes.
 *
 * The module also starts the task itself on Service_StartFiler and at
 * init (when the Wimp is already up), so RMLoading it on a running
 * desktop adds the icon without a reboot.
 */

#include "kernel.h"

#define NULL ((void *)0)

/* Wimp / OS SWIs (swis.h is more surface than this needs) */
#define Wimp_Initialise   0x400C0
#define Wimp_CreateIcon   0x400C2
#define Wimp_Poll         0x400C7
#define Wimp_CloseDown    0x400DD
#define Wimp_StartTask    0x400DE
#define Wimp_CreateMenu   0x400D4
#define XWimp_StartTask   0x600DE
#define XOS_CLI           0x20005

/* Service and icon-bar constants */
#define Service_StartFiler  0x4B
#define Iconbar_Left        (-2)          /* filing systems live here */

/* icon flags: indirected sprite+text, h/v centred, button type 3 (click),
 * foreground colour 7 (black) */
#define ICON_FLAGS  0x1700310Bu   /* sprite+text, h-centred, indirected, button 3 (RAMFSFiler pattern) */

static _kernel_oserror err_started =
    { 0x1B000000, "HostFSFiler is already running" };

/* the running task's handle, 0 when not running (one instance only) */
static int task_handle;

/* ---- the Wimp task -------------------------------------------------- */

static int poll[64];
static int icon[10];
static char disc_name[12] = "HostFS";
static char validation[16] = "Sharddisc";     /* S<sprite> for the bar icon */

/* menu: header (28) + 2 items (24 each): Info, Quit */
static int menu[28];
static char m_title[12] = "HostFS";
static char m_info[12]  = "Info";
static char m_quit[12]  = "Quit";

static void make_icon(void)
{
    _kernel_swi_regs r;

    icon[0] = -6;                         /* icon bar, left, with priority */
    icon[1] = 0;                          /* x0 */
    icon[2] = 0;                          /* y0 */
    icon[3] = 136;                        /* x1 */
    icon[4] = 68;                         /* y1: the icon-bar height */
    icon[5] = (int)ICON_FLAGS;
    icon[6] = (int)disc_name;             /* indirected text */
    icon[7] = (int)validation;            /* validation: the sprite */
    icon[8] = sizeof(disc_name);
    r.r[0] = 0;
    r.r[1] = (int)icon;
    _kernel_swi(Wimp_CreateIcon, &r, &r); /* r.r[0] = icon handle, unused */
}

static void build_menu(void)
{
    /* header */
    ((char *)menu)[0]  = 0;               /* title, filled below */
    /* title text, 12 bytes */
    {
        int i;
        for (i = 0; i < 12; i++) {
            ((char *)menu)[i] = (i < 6) ? m_title[i] : 0;
        }
    }
    ((char *)menu)[12] = 7;               /* title fg */
    ((char *)menu)[13] = 2;               /* title bg */
    ((char *)menu)[14] = 7;               /* work fg */
    ((char *)menu)[15] = 0;               /* work bg */
    menu[4] = 200;                        /* +16 width */
    menu[5] = 44;                         /* +20 item height */
    menu[6] = 0;                          /* +24 gap */
    /* item 0: Info (+28) */
    menu[7]  = 0;                         /* flags */
    menu[8]  = -1;                        /* submenu */
    menu[9]  = 0x07000021;               /* icon flags: text, filled, fg 7 */
    { int i; for (i = 0; i < 12; i++) ((char *)&menu[10])[i] = i < 4 ? m_info[i] : 0; }
    /* item 1: Quit (+52) */
    menu[13] = 0x80;                      /* last item */
    menu[14] = -1;
    menu[15] = 0x07000021;
    { int i; for (i = 0; i < 12; i++) ((char *)&menu[16])[i] = i < 4 ? m_quit[i] : 0; }
}

static void open_root(void)
{
    _kernel_swi_regs r;
    r.r[0] = (int)"Filer_OpenDir HostFS:$";
    _kernel_swi(XOS_CLI, &r, &r);         /* errors ignored: no window is fine */
}

static void show_menu(int x)
{
    _kernel_swi_regs r;
    r.r[1] = (int)menu;
    r.r[2] = x - 64;
    r.r[3] = 96 + 44 * 3;                 /* above the bar */
    _kernel_swi(Wimp_CreateMenu, &r, &r);
}

/* Run the Wimp task.  Entered as a task by Wimp_StartTask (the desktop
 * does this for Desktop_HostFSFiler), so the poll loop multitasks. */
static _kernel_oserror *run_task(void)
{
    _kernel_swi_regs r;
    _kernel_oserror *e;
    int done = 0;

    if (task_handle != 0) {
        return &err_started;
    }

    r.r[0] = 310;
    r.r[1] = 0x4B534154;                  /* "TASK" */
    r.r[2] = (int)"HostFS";
    e = _kernel_swi(Wimp_Initialise, &r, &r);
    if (e != NULL) {
        return e;
    }
    task_handle = r.r[1];

    build_menu();
    make_icon();

    while (!done) {
        r.r[0] = 0x00003831;              /* mask null and pointer moves */
        r.r[1] = (int)poll;
        _kernel_swi(Wimp_Poll, &r, &r);
        switch (r.r[0]) {
        case 6:                           /* Mouse_Click */
            if (poll[3] == Iconbar_Left) {
                if (poll[2] & 5) {        /* Select or Adjust */
                    open_root();
                } else if (poll[2] & 2) { /* Menu */
                    show_menu(poll[0]);
                }
            }
            break;
        case 9:                           /* Menu selection */
            if (poll[0] == 0) {
                open_root();              /* Info -> for now, open (placeholder) */
            } else if (poll[0] == 1) {
                done = 1;                 /* Quit */
            }
            break;
        case 17: case 18:                 /* User_Message */
            if (poll[4] == 0) {           /* Message_Quit */
                done = 1;
            }
            break;
        }
    }

    r.r[0] = task_handle;
    r.r[1] = 0x4B534154;
    _kernel_swi(Wimp_CloseDown, &r, &r);
    task_handle = 0;
    return NULL;
}

/* Ask the Wimp to start us as a task (used from init and the service). */
static void start_task(void)
{
    _kernel_swi_regs r;
    r.r[0] = (int)"Desktop_HostFSFiler";
    _kernel_swi(XWimp_StartTask, &r, &r); /* fails harmlessly if no Wimp yet */
}

/* ---- module lifecycle ---------------------------------------------- */

_kernel_oserror *hostfsfiler_init(const char *tail, int podule, void *pw)
{
    (void)tail; (void)podule; (void)pw;
    start_task();                         /* if a desktop is already up */
    return NULL;
}

_kernel_oserror *hostfsfiler_final(int fatal, int podule, void *pw)
{
    (void)fatal; (void)podule; (void)pw;
    if (task_handle != 0) {
        _kernel_swi_regs r;
        r.r[0] = task_handle;
        r.r[1] = 0x4B534154;
        _kernel_swi(Wimp_CloseDown, &r, &r);
        task_handle = 0;
    }
    return NULL;
}

void hostfsfiler_service(int service, _kernel_swi_regs *r, void *pw)
{
    (void)r; (void)pw;
    if (service == Service_StartFiler) {
        start_task();
    }
}

_kernel_oserror *hostfsfiler_command(const char *tail, int argc,
                                     int cmd_no, void *pw)
{
    (void)tail; (void)argc; (void)pw;
    if (cmd_no == 0) {                    /* Desktop_HostFSFiler: be the task */
        return run_task();
    }
    start_task();                         /* *HostFSFiler: spawn the task */
    return NULL;
}
