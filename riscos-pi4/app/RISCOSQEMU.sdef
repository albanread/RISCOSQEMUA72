			</direct-parameter>
			<result>
				<type type="text" description="The JSON reply envelope."/>
			</result>
		</command>
		<command name="pause" code="MQemPaus" description="Stop the virtual CPUs; the reply envelope reports the paused state.">
			<direct-parameter>
				<type type="text" optional="yes" description="A JSON command object; omitted means ping."/>
			</direct-parameter>
			<result>
