	<suite name="RISC OS QEMU suite" code="MQem" description="Controlling and debugging the emulated machine.">
		<command name="ping" code="MQemPing" description="Round-trip a command through the surface; the reply is the envelope.">
			<direct-parameter>
				<type type="text" optional="yes" description="A JSON command object; omitted means ping."/>
			</direct-parameter>
			<result>
				<type type="text" description="The JSON reply envelope."/>
			</result>
		</command>
